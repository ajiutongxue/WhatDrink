# Copy to .env and set a private password hash from: python -m server.create_password_hash
APP_ENV=development
APP_PASSWORD_HASH=replace-with-scrypt-hash
# Generate a private key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=replace-with-generated-fernet-key
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://127.0.0.1:5173
DATA_DIR=runtime
