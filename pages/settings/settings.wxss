/* ============================================================
   Settings Page — 设置
   ============================================================ */

.setting-hint {
  font-size: 24rpx;
  color: var(--ink4);
  margin-bottom: 20rpx;
  line-height: 1.8;
}

.setting-group {
  margin-bottom: 40rpx;
}

.setting-label {
  font-size: 22rpx;
  color: var(--ink4);
  margin-bottom: 12rpx;
  display: block;
  letter-spacing: 2rpx;
}

.setting-input {
  width: 100%;
  border: none;
  border-bottom: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: 0;
  padding: 16rpx 4rpx;
  font-size: 28rpx;
  background: transparent;
  color: var(--ink);
  outline: none;
}

.setting-input-short {
  width: 160rpx;
  text-align: center;
}

.setting-row {
  display: flex;
  gap: 32rpx;
}

.setting-row .setting-group {
  flex: 1;
}

.radio-group {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.radio-group label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: var(--ink2);
}

.setting-toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.setting-toggle-label {
  font-size: 28rpx;
  color: var(--ink2);
}

.setting-model-hint {
  font-size: 22rpx;
  color: var(--ink4);
  margin-top: 8rpx;
}

.setting-inline-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-inline-hint {
  font-size: 24rpx;
  color: var(--ink4);
}

.setting-btn {
  padding: 16rpx 32rpx;
  border: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: var(--r-md);
  background: transparent;
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.5;
}

.setting-btn::after {
  border: none;
}

.setting-btn[disabled] {
  opacity: 0.4;
}

.setting-btn.danger {
  color: var(--rose);
  border-color: rgba(166, 123, 123, 0.4);
}

.data-btn-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.sync-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(176, 164, 148, 0.2);
  margin-bottom: 24rpx;
}

.sync-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sync-label {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.sync-status {
  font-size: 22rpx;
  color: var(--ink4);
}

/* ============================================================
   Constitution Quiz
   ============================================================ */
.quiz-desc {
  font-size: 24rpx;
  color: var(--ink4);
  margin-bottom: 24rpx;
  line-height: 1.8;
}

.quiz-q {
  margin-bottom: 32rpx;
}

.quiz-q-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.quiz-opts {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.quiz-opt {
  padding: 14rpx 28rpx;
  border: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: var(--r-md);
  font-size: 26rpx;
  color: var(--ink2);
  background: transparent;
}

.quiz-opt.selected {
  background: var(--ink);
  color: #FDFBF7;
  border-color: var(--ink);
}

.quiz-result {
  margin-top: 32rpx;
  padding: 28rpx 0;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--gold);
}

.quiz-result-label {
  font-size: 22rpx;
  color: var(--ink4);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.quiz-result-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.quiz-result-hint {
  font-size: 24rpx;
  color: var(--ink3);
  line-height: 1.8;
}

.quiz-reset {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 1rpx;
}

/* ============================================================
   运行诊断
   ============================================================ */
.diag-meta {
  font-size: 20rpx;
  color: var(--ink4);
  margin-left: auto;
  letter-spacing: 1rpx;
}

.diag-toggle {
  font-size: 20rpx;
  color: var(--gold);
  letter-spacing: 1rpx;
}

.diag-hint {
  font-size: 22rpx;
  color: var(--ink4);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.diag-empty {
  font-size: 24rpx;
  color: var(--ink4);
  text-align: center;
  padding: 36rpx 0;
}

.diag-list {
  max-height: 620rpx;
  border-top: 1rpx solid rgba(176, 164, 148, 0.2);
}

.diag-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(176, 164, 148, 0.15);
}

.diag-item.err {
  border-left: 4rpx solid var(--rose);
  padding-left: 16rpx;
}

.diag-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.diag-time {
  font-size: 20rpx;
  color: var(--ink4);
  flex-shrink: 0;
}

.diag-event {
  font-size: 24rpx;
  color: var(--ink2);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.diag-item.err .diag-event {
  color: var(--rose);
}

.diag-ms {
  font-size: 20rpx;
  color: var(--ink4);
}

.diag-fail {
  font-size: 18rpx;
  color: #FDFBF7;
  background: var(--rose);
  padding: 0 12rpx;
  border-radius: 4rpx;
  line-height: 1.6;
}

.diag-detail {
  font-size: 20rpx;
  color: var(--ink3);
  margin-top: 6rpx;
  line-height: 1.6;
  word-break: break-all;
}

.diag-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
