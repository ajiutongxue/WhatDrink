<view class="page-container">

  <!-- ========== 个人档案 ========== -->
  <view class="card">
    <view class="card-title">
      <text class="icon">👤</text>
      <text>个人档案</text>
    </view>

    <view class="setting-row">
      <view class="setting-group">
        <text class="setting-label">性别</text>
        <view class="radio-group">
          <label>
            <radio value="male" checked="{{gender === 'male'}}" color="#C4793B" bindtap="onGenderTap" data-value="male" />
            <text>男</text>
          </label>
          <label>
            <radio value="female" checked="{{gender === 'female'}}" color="#C4793B" bindtap="onGenderTap" data-value="female" />
            <text>女</text>
          </label>
        </view>
      </view>
      <view class="setting-group">
        <text class="setting-label">年龄</text>
        <input
          class="setting-input"
          type="number"
          value="{{age}}"
          bindinput="onAgeInput"
          placeholder="年龄"
        />
      </view>
    </view>

    <view class="setting-group">
      <text class="setting-label">常驻城市</text>
      <input
        class="setting-input"
        type="text"
        value="{{city}}"
        bindinput="onCityInput"
        placeholder="例如：上海"
      />
    </view>

    <view class="save-btn-row">
      <button class="save-btn" bindtap="onSaveProfile">保存</button>
    </view>
  </view>

  <!-- ========== 体质辨识 ========== -->
  <view class="card">
    <view class="card-title">
      <text class="icon">🏥</text>
      <text>体质辨识</text>
    </view>
    <view class="quiz-desc" wx:if="{{!constitution}}">5 道题帮你判断体质，推荐更贴合你身体的茶。</view>

    <block wx:for="{{quizQuestions}}" wx:for-index="qIdx" wx:key="text">
      <view class="quiz-q">
        <view class="quiz-q-text">{{item.text}}</view>
        <view class="quiz-opts">
          <text
            wx:for="{{item.options}}"
            wx:for-item="opt"
            wx:key="value"
            class="quiz-opt {{quizAnswers[qIdx] === opt.value ? 'selected' : ''}}"
            data-qi="{{qIdx}}"
            data-value="{{opt.value}}"
            bindtap="onQuizTap"
          >{{opt.label}}</text>
        </view>
      </view>
    </block>

    <!-- Result -->
    <view class="quiz-result" wx:if="{{constitution}}">
      <view class="quiz-result-label">你的体质</view>
      <view class="quiz-result-value">{{constitutionText}}</view>
      <view class="quiz-result-hint">{{constitutionHint}}</view>
      <text class="quiz-reset" bindtap="onQuizReset">重新测试</text>
    </view>

    <view class="save-btn-row">
      <button class="save-btn" bindtap="onSaveQuiz">保存</button>
    </view>
  </view>

  <!-- ========== AI 配置 ========== -->
  <view class="card">
    <view class="card-title">
      <text class="icon">🧠</text>
      <text>AI 配置</text>
    </view>

    <view class="setting-hint">
      开启后使用大模型深度分析你的状况，生成更精准的推荐和更丰富的茶知识解读。
    </view>

    <view class="setting-group">
      <text class="setting-label">API Key</text>
      <input
        class="setting-input"
        type="text"
        password="{{true}}"
        value="{{apiKey}}"
        bindinput="onApiKeyInput"
        placeholder="输入 API Key"
      />
    </view>

    <view class="setting-group">
      <text class="setting-label">API 端点</text>
      <input
        class="setting-input"
        type="text"
        value="{{endpoint}}"
        bindinput="onEndpointInput"
        placeholder="https://xxx.maas.aliyuncs.com/compatible-mode/v1"
      />
    </view>

    <!-- Parser toggle + model -->
    <view class="setting-group">
      <view class="setting-toggle-row">
        <text class="setting-toggle-label">智能解析</text>
        <switch checked="{{parserEnabled}}" color="#C4793B" bindchange="onParserToggle" />
      </view>
      <input
        class="setting-input"
        type="text"
        value="{{parserModel}}"
        bindinput="onParserModelInput"
        placeholder="deepseek-v3"
        wx:if="{{parserEnabled}}"
      />
      <view class="setting-model-hint" wx:if="{{parserEnabled}}">轻量模型，用于解析输入文本</view>
    </view>

    <!-- Recommend toggle + model -->
    <view class="setting-group">
      <view class="setting-toggle-row">
        <text class="setting-toggle-label">深度推荐</text>
        <switch checked="{{recEnabled}}" color="#C4793B" bindchange="onRecToggle" />
      </view>
      <input
        class="setting-input"
        type="text"
        value="{{recModel}}"
        bindinput="onRecModelInput"
        placeholder="deepseek-v4-pro"
        wx:if="{{recEnabled}}"
      />
      <view class="setting-model-hint" wx:if="{{recEnabled}}">深度模型，用于生成推荐和茶知识解读</view>
    </view>

    <view class="save-btn-row">
      <button class="save-btn" bindtap="onSaveLLM">保存</button>
    </view>
  </view>

  <!-- ========== 推荐设置 ========== -->
  <view class="card">
    <view class="card-title">
      <text class="icon">🎯</text>
      <text>推荐设置</text>
    </view>

    <view class="setting-group">
      <text class="setting-label">反重复天数</text>
      <view class="setting-inline-row">
        <input
          class="setting-input setting-input-short"
          type="number"
          value="{{avoidDays}}"
          bindinput="onAvoidDaysInput"
        />
        <text class="setting-inline-hint">天内不重复推荐同一款茶</text>
      </view>
    </view>

    <view class="save-btn-row">
      <button class="save-btn" bindtap="onSaveRecommend">保存</button>
    </view>
  </view>

  <!-- ========== 数据管理 ========== -->
  <view class="card">
    <view class="card-title">
      <text class="icon">💾</text>
      <text>数据管理</text>
    </view>

    <!-- Cloud sync status -->
    <view class="sync-status-row">
      <view class="sync-info">
        <text class="sync-label">云同步</text>
        <text class="sync-status">{{syncStatus}}</text>
      </view>
      <button class="setting-btn" bindtap="onSyncNow" disabled="{{syncing}}">
        {{syncing ? '同步中...' : '立即同步'}}
      </button>
    </view>

    <!-- Data actions -->
    <view class="data-btn-row">
      <button class="setting-btn" bindtap="onExport">导出数据</button>
      <button class="setting-btn" bindtap="onImport">导入数据</button>
      <button class="setting-btn danger" bindtap="onReset">重置所有</button>
    </view>
  </view>

  <!-- ========== 运行诊断 ========== -->
  <view class="card">
    <view class="card-title diag-header" bindtap="onToggleDiag">
      <text class="icon">🩺</text>
      <text>运行诊断</text>
      <text class="diag-meta">{{diagLogs.length ? diagLogs.length + ' 条记录' : '暂无记录'}}</text>
      <text class="diag-toggle">{{showDiag ? '收起 ▴' : '展开 ▾'}}</text>
    </view>

    <block wx:if="{{showDiag}}">
      <view class="diag-hint">自动记录推荐流程关键节点与失败原因（最近 30 条），推荐异常时先来这里看看。</view>

      <view class="diag-empty" wx:if="{{diagLogs.length === 0}}">暂无日志，去首页点一次「推荐」试试</view>

      <scroll-view class="diag-list" scroll-y wx:else>
        <view class="diag-item {{item.ok === false ? 'err' : ''}}" wx:for="{{diagLogs}}" wx:key="id">
          <view class="diag-line">
            <text class="diag-time">{{item.time}}</text>
            <text class="diag-event">{{item.event}}</text>
            <text class="diag-ms" wx:if="{{item.ms !== ''}}">{{item.ms}}ms</text>
            <text class="diag-fail" wx:if="{{item.ok === false}}">失败</text>
          </view>
          <view class="diag-detail" wx:if="{{item.detail}}">{{item.detail}}</view>
        </view>
      </scroll-view>

      <view class="diag-actions">
        <button class="setting-btn" bindtap="onRefreshDiag">刷新</button>
        <button class="setting-btn danger" bindtap="onClearDiag">清空日志</button>
      </view>
    </block>
  </view>

</view>
