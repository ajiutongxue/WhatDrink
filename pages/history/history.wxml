<view class="page-container">

  <view class="card">
    <view class="card-title">
      <text class="icon">📅</text>
      <text>饮茶记录</text>
      <text class="history-stats-btn" bindtap="onTapStats">📊 统计</text>
    </view>

    <!-- Empty State -->
    <view class="history-empty" wx:if="{{historyList.length === 0}}">
      <view class="history-empty-icon">🍵</view>
      <view>还没有饮茶记录</view>
      <view class="history-empty-hint">去首页开始你的第一杯茶吧</view>
    </view>

    <!-- History List -->
    <view wx:if="{{historyList.length > 0}}">
      <block wx:for="{{historyList}}" wx:key="index">

        <!-- Skip Entry (muted) -->
        <view class="history-item" wx:if="{{item.isSkip}}">
          <view class="history-date-col">
            <text class="history-date">{{item.dateShort}}</text>
          </view>
          <view class="history-dot cat-dot-skip"></view>
          <view class="history-tea">
            <view class="history-tea-name skip-name">{{item.teaName}}</view>
          </view>
        </view>

        <!-- Normal Entry -->
        <view class="history-item-wrap" wx:else>
          <view class="history-item">
            <view class="history-date-col">
              <text class="history-date">{{item.dateShort}}</text>
              <text class="history-time" wx:if="{{item.checkinTime}}">{{item.checkinTime}}</text>
            </view>
            <view class="history-dot cat-dot-{{item.teaCat}}"></view>
            <view class="history-tea">
              <view class="history-tea-name">
                <text>{{item.teaName}}</text>
                <text class="history-badge {{item.typeBadgeClass}}" wx:if="{{item.typeName}}">{{item.typeName}}</text>
              </view>
              <view class="history-tea-cat">
                <text wx:if="{{item.teaBrand}}">{{item.teaBrand}} · </text>
                <text>{{item.teaCatName}}</text>
              </view>
            </view>
            <text class="history-notes-btn" bindtap="onToggleNotes" data-idx="{{item.idx}}">
              {{item.hasNotes ? '📝' : '✏️'}}
            </text>
          </view>

          <!-- Existing tasting notes display (show when not editing this entry) -->
          <view class="history-notes-display" wx:if="{{item.hasNotes && editingIdx !== item.idx}}">
            <text wx:if="{{item.tastingNotes}}">{{item.tastingNotes}}</text>
            <view class="history-img-grid" wx:if="{{item.imageFileIDs.length > 0}}">
              <view class="history-img-saved-item" wx:for="{{item.imageFileIDs}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="fileID">
                <image class="history-img-thumb" src="{{img.fileID}}" mode="aspectFill" data-src="{{img.fileID}}" data-list-idx="{{index}}" bindtap="onPreviewImage"></image>
                <text class="history-img-caption-text" wx:if="{{img.caption}}">{{img.caption}}</text>
              </view>
            </view>
          </view>

          <!-- Editing area -->
          <view class="history-notes-edit" wx:if="{{editingIdx === item.idx}}">
            <textarea
              class="history-notes-textarea"
              value="{{editingText}}"
              bindinput="onNotesInput"
              placeholder="口感、香气、回甘、体感、心情..."
              maxlength="500"
              auto-height
              focus="{{editingIdx === item.idx}}"
            />
            <view class="history-img-grid" wx:if="{{editingImages.length > 0}}">
              <view class="history-img-item" wx:for="{{editingImages}}" wx:key="fileID">
                <image class="history-img-thumb" src="{{item.fileID}}" mode="aspectFill" data-src="{{item.fileID}}" bindtap="onPreviewImage"></image>
                <view class="history-img-del" data-idx="{{index}}" catchtap="onRemoveImage">×</view>
                <input class="history-img-caption" value="{{item.caption}}" data-idx="{{index}}" bindinput="onCaptionInput" placeholder="说明" maxlength="40" />
              </view>
            </view>
            <view class="history-img-add" wx:if="{{editingImages.length < 6}}" bindtap="onChooseImage">
              <text class="history-img-add-icon">+</text>
              <text class="history-img-add-text">{{editingImages.length}}/6</text>
            </view>
            <view class="history-notes-actions">
              <text class="history-notes-count">{{editingText.length}}/500</text>
              <button class="history-notes-save" bindtap="onSaveNotes">保存</button>
            </view>
          </view>
        </view>

      </block>
    </view>
  </view>

</view>
