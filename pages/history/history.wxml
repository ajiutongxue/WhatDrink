<view class="page-container">

  <view class="card">
    <view class="card-title">
      <text class="icon">📅</text>
      <text>饮茶记录</text>
    </view>

    <!-- Empty State -->
    <view class="history-empty" wx:if="{{historyList.length === 0}}">
      <view class="history-empty-icon">🍵</view>
      <view>还没有饮茶记录</view>
      <view class="history-empty-hint">去首页开始你的第一杯茶吧</view>
    </view>

    <!-- History List -->
    <view wx:if="{{historyList.length > 0}}">
      <block wx:for="{{historyList}}" wx:key="index">

        <!-- Skip Entry (muted) -->
        <view class="history-item" wx:if="{{item.isSkip}}">
          <text class="history-date">{{item.dateShort}}</text>
          <view class="history-dot cat-dot-skip"></view>
          <view class="history-tea">
            <view class="history-tea-name skip-name">{{item.teaName}}</view>
          </view>
        </view>

        <!-- Normal Entry -->
        <view class="history-item" wx:else>
          <text class="history-date">{{item.dateShort}}</text>
          <view class="history-dot cat-dot-{{item.teaCat}}"></view>
          <view class="history-tea">
            <view class="history-tea-name">
              <text>{{item.teaName}}</text>
              <text class="history-badge {{item.typeBadgeClass}}" wx:if="{{item.typeName}}">{{item.typeName}}</text>
            </view>
            <view class="history-tea-cat">
              <text wx:if="{{item.teaBrand}}">{{item.teaBrand}} · </text>
              <text>{{item.teaCatName}}</text>
            </view>
          </view>
        </view>

      </block>
    </view>
  </view>

</view>
