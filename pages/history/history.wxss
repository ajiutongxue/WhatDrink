/* ============================================================
   History Page — 饮茶记录 「暖屿」
   ============================================================ */

.history-empty {
  text-align: center;
  color: var(--ink4);
  padding: 100rpx 40rpx;
  font-size: 28rpx;
  line-height: 2;
}

.history-empty-icon {
  font-size: 52rpx;
  margin-bottom: 24rpx;
}

.history-empty-hint {
  font-size: 24rpx;
  color: var(--ink4);
  margin-top: 8rpx;
}

.history-item-wrap {
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.3);
}

.history-item-wrap:last-child {
  border-bottom: none;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
}

.history-date-col {
  display: flex;
  flex-direction: column;
  min-width: 92rpx;
}

.history-date {
  font-size: 24rpx;
  color: var(--ink4);
}

.history-time {
  font-size: 20rpx;
  color: var(--ink4);
  opacity: 0.7;
  margin-top: 4rpx;
}

.history-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.history-tea {
  flex: 1;
}

.history-tea-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--cocoa);
  letter-spacing: 1rpx;
}

.history-tea-cat {
  font-size: 22rpx;
  color: var(--ink4);
  margin-top: 4rpx;
}

.history-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  margin-left: 8rpx;
  letter-spacing: 1rpx;
}

.badge-primary {
  background: var(--coral-soft);
  color: var(--coral-deep);
}

.badge-alt {
  background: var(--cream2);
  color: var(--ink3);
}

.badge-custom {
  background: var(--sage-soft);
  color: var(--sage-deep);
}

.skip-name {
  color: var(--ink4);
}

/* Category dot colors */
.cat-dot-green { background: #8FAE87; }
.cat-dot-black { background: #9C7B6A; }
.cat-dot-white { background: #BCC4BC; }
.cat-dot-oolong_tieguanyin,
.cat-dot-oolong_wuyi,
.cat-dot-oolong_dancong { background: #DE8260; }
.cat-dot-puerh_raw { background: #8FAE87; }
.cat-dot-puerh_ripe { background: #6B5344; }
.cat-dot-flavored_jasmine,
.cat-dot-flavored_other { background: #C98A9A; }
.cat-dot-unknown { background: var(--coral); }
.cat-dot-none,
.cat-dot-skip { background: var(--ink4); }

/* ============================================================
   Tasting Notes (history page)
   ============================================================ */
.history-notes-btn {
  font-size: 32rpx;
  flex-shrink: 0;
  padding: 8rpx;
  opacity: 0.7;
}

.history-notes-display {
  padding: 0 0 20rpx 132rpx;
  font-size: 24rpx;
  color: var(--ink3);
  line-height: 1.8;
}

.history-notes-edit {
  padding: 0 0 20rpx 0;
}

.history-notes-textarea {
  width: 100%;
  min-height: 100rpx;
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: var(--cream);
  line-height: 1.8;
  box-sizing: border-box;
}

.history-notes-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.history-notes-count {
  font-size: 22rpx;
  color: var(--ink4);
}

.history-notes-save {
  padding: 10rpx 30rpx;
  border: none;
  border-radius: var(--r-pill);
  background: var(--coral);
  color: #FFFFFF;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.history-notes-save::after {
  border: none;
}

.history-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.history-img-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.history-img-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--r-sm);
  background: var(--cream2);
}

.history-img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(62, 47, 43, 0.65);
  color: #FFF;
  border-radius: 50%;
  font-size: 24rpx;
}

.history-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  margin-top: 12rpx;
  border: 1rpx dashed rgba(222, 130, 96, 0.4);
  border-radius: var(--r-sm);
  background: var(--cream);
}

.history-img-add-icon {
  font-size: 48rpx;
  color: var(--ink4);
  line-height: 1;
}

.history-img-add-text {
  font-size: 20rpx;
  color: var(--ink4);
  margin-top: 8rpx;
}

.history-img-caption {
  width: 180rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink);
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-sm);
  padding: 4rpx 8rpx;
  text-align: center;
  background: transparent;
}

.history-img-saved-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.history-img-caption-text {
  width: 180rpx;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink4);
  text-align: center;
  line-height: 1.4;
  word-break: break-all;
}

/* Stats entry button */
.history-stats-btn {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--coral-deep);
  background: var(--coral-soft);
  padding: 8rpx 22rpx;
  border-radius: var(--r-pill);
  letter-spacing: 1rpx;
}

.history-preference-action { display:flex; align-items:center; gap:16rpx; margin:18rpx 0 8rpx; }
.history-avoid-link { color:#9b6b47; font-size:24rpx; padding:6rpx 0; }
.history-avoid-link.is-active { color:#61806a; }
.history-avoid-hint { color:#aaa196; font-size:21rpx; }
