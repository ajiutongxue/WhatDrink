/* ============================================================
   History Page — 饮茶记录
   ============================================================ */

.history-empty {
  text-align: center;
  color: #B5A89A;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.8;
}

.history-empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.history-empty-hint {
  font-size: 24rpx;
  color: #B5A89A;
  margin-top: 8rpx;
}

.history-item-wrap {
  border-bottom: 1rpx solid #F0EBE3;
}

.history-item-wrap:last-child {
  border-bottom: none;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
}

.history-date {
  font-size: 24rpx;
  color: #B5A89A;
  min-width: 92rpx;
  font-weight: 500;
}

.history-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.history-tea {
  flex: 1;
}

.history-tea-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2A1E;
}

.history-tea-cat {
  font-size: 22rpx;
  color: #B5A89A;
  margin-top: 4rpx;
}

.history-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

.badge-primary {
  background: #C4793B;
  color: #FFFFFF;
}

.badge-alt {
  background: #F0E8DA;
  color: #8A7668;
}

.badge-custom {
  background: #E0F2F1;
  color: #00695C;
}

.skip-name {
  color: #B5A89A;
  font-weight: 400;
}

/* Category dot colors */
.cat-dot-green { background: #6A9B5C; }
.cat-dot-black { background: #8D6E63; }
.cat-dot-white { background: #B0BEC5; }
.cat-dot-oolong_tieguanyin,
.cat-dot-oolong_wuyi,
.cat-dot-oolong_dancong { background: #D4943A; }
.cat-dot-puerh_raw { background: #6A9B5C; }
.cat-dot-puerh_ripe { background: #5D4037; }
.cat-dot-flavored_jasmine,
.cat-dot-flavored_other { background: #C27070; }
.cat-dot-unknown { background: #C4793B; }
.cat-dot-none,
.cat-dot-skip { background: #B5A89A; }

/* ============================================================
   Tasting Notes (history page)
   ============================================================ */
.history-notes-btn {
  font-size: 32rpx;
  flex-shrink: 0;
  padding: 8rpx;
}

.history-notes-display {
  padding: 0 0 20rpx 132rpx;
  font-size: 24rpx;
  color: #8A7668;
  line-height: 1.7;
}

.history-notes-edit {
  padding: 0 0 20rpx 0;
}

.history-notes-textarea {
  width: 100%;
  min-height: 100rpx;
  border: 3rpx solid #F0EBE3;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #3A2A1E;
  background: #FAF5ED;
  line-height: 1.6;
  box-sizing: border-box;
}

.history-notes-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.history-notes-count {
  font-size: 22rpx;
  color: #B5A89A;
}

.history-notes-save {
  padding: 10rpx 28rpx;
  border: none;
  border-radius: 40rpx;
  background: #C4793B;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.history-notes-save::after {
  border: none;
}

.history-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.history-img-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.history-img-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #F0E8DA;
}

.history-img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
}

.history-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  margin-top: 12rpx;
  border: 2rpx dashed #D3C3B0;
  border-radius: 12rpx;
  background: #FAF5ED;
}

.history-img-add-icon {
  font-size: 52rpx;
  color: #B5A89A;
  line-height: 1;
}

.history-img-add-text {
  font-size: 20rpx;
  color: #B5A89A;
  margin-top: 8rpx;
}

/* Stats entry button */
.history-stats-btn {
  margin-left: auto;
  font-size: 24rpx;
  color: #C4793B;
  background: #FAF0E6;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
}
