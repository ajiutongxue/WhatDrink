/* ============================================================
   History Page — 饮茶记录
   ============================================================ */

.history-empty {
  text-align: center;
  color: var(--ink4);
  padding: 100rpx 40rpx;
  font-size: 28rpx;
  line-height: 2;
}

.history-empty-icon {
  font-size: 48rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.history-empty-hint {
  font-size: 24rpx;
  color: var(--ink4);
  margin-top: 8rpx;
}

.history-item-wrap {
  border-bottom: 1rpx solid rgba(176, 164, 148, 0.2);
}

.history-item-wrap:last-child {
  border-bottom: none;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
}

.history-date-col {
  display: flex;
  flex-direction: column;
  min-width: 92rpx;
}

.history-date {
  font-size: 24rpx;
  color: var(--ink4);
}

.history-time {
  font-size: 20rpx;
  color: var(--ink4);
  opacity: 0.7;
  margin-top: 4rpx;
}

.history-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.history-tea {
  flex: 1;
}

.history-tea-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.history-tea-cat {
  font-size: 22rpx;
  color: var(--ink4);
  margin-top: 4rpx;
}

.history-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 8rpx;
  letter-spacing: 1rpx;
}

.badge-primary {
  background: var(--gold-dim);
  color: var(--gold);
}

.badge-alt {
  background: rgba(176, 164, 148, 0.1);
  color: var(--ink3);
}

.badge-custom {
  background: rgba(122, 139, 111, 0.1);
  color: var(--sage);
}

.skip-name {
  color: var(--ink4);
}

/* Category dot colors */
.cat-dot-green { background: #7A8B6F; }
.cat-dot-black { background: #8A7060; }
.cat-dot-white { background: #A8B0A8; }
.cat-dot-oolong_tieguanyin,
.cat-dot-oolong_wuyi,
.cat-dot-oolong_dancong { background: #B8956B; }
.cat-dot-puerh_raw { background: #7A8B6F; }
.cat-dot-puerh_ripe { background: #5A4A3A; }
.cat-dot-flavored_jasmine,
.cat-dot-flavored_other { background: #A67B7B; }
.cat-dot-unknown { background: var(--gold); }
.cat-dot-none,
.cat-dot-skip { background: var(--ink4); }

/* ============================================================
   Tasting Notes (history page)
   ============================================================ */
.history-notes-btn {
  font-size: 32rpx;
  flex-shrink: 0;
  padding: 8rpx;
  opacity: 0.6;
}

.history-notes-display {
  padding: 0 0 20rpx 132rpx;
  font-size: 24rpx;
  color: var(--ink3);
  line-height: 1.8;
}

.history-notes-edit {
  padding: 0 0 20rpx 0;
}

.history-notes-textarea {
  width: 100%;
  min-height: 100rpx;
  border: 1rpx solid rgba(176, 164, 148, 0.3);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: rgba(255, 253, 248, 0.4);
  line-height: 1.8;
  box-sizing: border-box;
}

.history-notes-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.history-notes-count {
  font-size: 22rpx;
  color: var(--ink4);
}

.history-notes-save {
  padding: 10rpx 28rpx;
  border: none;
  border-radius: var(--r-md);
  background: var(--ink);
  color: #FDFBF7;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.history-notes-save::after {
  border: none;
}

.history-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.history-img-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.history-img-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--r-sm);
  background: rgba(176, 164, 148, 0.1);
}

.history-img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(44, 36, 24, 0.6);
  color: #FDFBF7;
  border-radius: 50%;
  font-size: 24rpx;
}

.history-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  margin-top: 12rpx;
  border: 1rpx dashed rgba(176, 164, 148, 0.5);
  border-radius: var(--r-sm);
  background: rgba(255, 253, 248, 0.3);
}

.history-img-add-icon {
  font-size: 48rpx;
  color: var(--ink4);
  line-height: 1;
}

.history-img-add-text {
  font-size: 20rpx;
  color: var(--ink4);
  margin-top: 8rpx;
}

.history-img-caption {
  width: 180rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink);
  border: 1rpx solid rgba(176, 164, 148, 0.3);
  border-radius: var(--r-sm);
  padding: 4rpx 8rpx;
  text-align: center;
  background: transparent;
}

.history-img-saved-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.history-img-caption-text {
  width: 180rpx;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink4);
  text-align: center;
  line-height: 1.4;
  word-break: break-all;
}

/* Stats entry button */
.history-stats-btn {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--gold);
  background: var(--gold-dim);
  padding: 8rpx 20rpx;
  border-radius: var(--r-sm);
  letter-spacing: 1rpx;
}
