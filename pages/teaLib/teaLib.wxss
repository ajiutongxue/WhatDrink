/* ============================================================
   Tea Library Page — 茶叶库 「暖屿」
   ============================================================ */

/* Toolbar */
.tea-lib-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tea-lib-add-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--r-pill);
  background: var(--coral);
  color: #FFFFFF;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx rgba(222, 130, 96, 0.28);
}

.tea-lib-edit-btn {
  padding: 22rpx 36rpx;
  border-radius: var(--r-pill);
  background: var(--cream);
  color: var(--ink2);
  font-size: 26rpx;
  border: 1rpx solid var(--card-border);
  letter-spacing: 1rpx;
}

.tea-lib-edit-btn.active {
  background: var(--cocoa);
  color: var(--cream);
  border-color: var(--cocoa);
}

/* Filter Bar */
.tea-lib-filter-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.tea-lib-filter-inner {
  display: inline-flex;
  padding: 8rpx 0 16rpx;
}

.tea-lib-filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  margin-right: 16rpx;
  background: var(--cream);
  color: var(--ink3);
  border: 1rpx solid var(--card-border);
  white-space: nowrap;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.tea-lib-filter-item.active {
  background: var(--coral);
  color: #FFFFFF;
  border-color: var(--coral);
}

/* Summary */
.tea-lib-summary {
  font-size: 22rpx;
  color: var(--ink4);
  margin-bottom: 20rpx;
  padding: 0 4rpx;
  letter-spacing: 1rpx;
}

/* Group */
.tea-lib-group {
  margin-bottom: 24rpx;
  padding: 24rpx 0;
}

.tea-lib-cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0 16rpx;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.3);
  margin-bottom: 8rpx;
}

.tea-lib-cat-name {
  font-size: 28rpx;
  color: var(--cocoa);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.tea-lib-cat-count {
  font-size: 22rpx;
  color: var(--ink4);
}

/* Tea Item */
.tea-lib-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.2);
  font-size: 26rpx;
}

.tea-lib-item:last-child {
  border-bottom: none;
}

.tea-lib-item.is-disabled {
  opacity: 0.4;
}

.tea-lib-cat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.tea-lib-name {
  flex: 1;
  font-weight: 400;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 8rpx;
  letter-spacing: 1rpx;
}

.tea-lib-note {
  font-size: 20rpx;
  opacity: 0.6;
}

.tea-lib-disabled-tag {
  font-size: 18rpx;
  color: #FFF;
  background: var(--ink4);
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
}

.tea-lib-props {
  font-size: 22rpx;
  color: var(--ink4);
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.tea-lib-year {
  font-size: 22rpx;
  color: var(--ink4);
}

.tea-lib-caffeine {
  font-size: 22rpx;
  color: var(--ink4);
}

/* Nature mini tag */
.nature-mini-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--r-pill);
  color: #FFFFFF;
}

.nature-mini-tag.nature-han { background: #7FA6C0; }
.nature-mini-tag.nature-liang { background: #8FC0C8; }
.nature-mini-tag.nature-ping { background: #A8A89C; }
.nature-mini-tag.nature-wen { background: #D99A6A; }
.nature-mini-tag.nature-re { background: #CE7A66; }

/* Category dot colors */
.cat-dot-green { background: #8FAE87; }
.cat-dot-black { background: #9C7B6A; }
.cat-dot-white { background: #BCC4BC; }
.cat-dot-oolong_tieguanyin,
.cat-dot-oolong_wuyi,
.cat-dot-oolong_dancong { background: #DE8260; }
.cat-dot-puerh_raw { background: #8FAE87; }
.cat-dot-puerh_ripe { background: #6B5344; }
.cat-dot-flavored_jasmine,
.cat-dot-flavored_other { background: #C98A9A; }

/* Empty */
.tea-lib-empty {
  text-align: center;
  color: var(--ink4);
  padding: 100rpx 40rpx;
  font-size: 28rpx;
}

/* ============================================================
   Edit Mode — Flat List
   ============================================================ */
.tea-lib-flat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 4rpx;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.2);
}

.tea-lib-flat-item.is-disabled {
  opacity: 0.4;
}

.tea-lib-flat-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.tea-lib-flat-info {
  flex: 1;
  min-width: 0;
}

.tea-lib-flat-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 10rpx;
  letter-spacing: 1rpx;
}

.tea-lib-flat-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink4);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tea-lib-flat-cat {
  color: var(--ink4);
}

.tea-lib-flat-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.tea-lib-act {
  width: 52rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink2);
  background: var(--cream2);
  border-radius: var(--r-sm);
}

.tea-lib-act.danger {
  color: #B05A4A;
  background: rgba(200, 120, 110, 0.12);
}

/* ============================================================
   Form Popup
   ============================================================ */
.tea-lib-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(62, 47, 43, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.tea-lib-form {
  width: 100%;
  background: var(--cream);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}

.tea-lib-form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--cocoa);
  text-align: center;
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
}

.tea-lib-field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.3);
}

.tea-lib-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--ink2);
  flex-shrink: 0;
}

.tea-lib-label .req {
  color: #B05A4A;
}

.tea-lib-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.tea-lib-ph {
  color: var(--ink4);
  font-size: 26rpx;
}

.tea-lib-picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.tea-lib-avoid-field {
  justify-content: space-between;
}

.tea-lib-avoid-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tea-lib-avoid-label {
  width: auto;
}

.tea-lib-avoid-hint {
  color: var(--ink4);
  font-size: 22rpx;
}

.tea-lib-form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.tea-lib-form-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--r-pill);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.tea-lib-form-btn.cancel {
  background: var(--cream2);
  color: var(--ink3);
}

.tea-lib-form-btn.save {
  background: var(--coral);
  color: #FFFFFF;
}

.tea-lib-knowledge, .tea-lib-inventory { font-size: 19rpx; color: var(--ink4); }
.tea-lib-knowledge { color: #6F8B69; }
.tea-lib-knowledge.missing { color: #B07A54; }
.tea-lib-inventory { color: #8A6B58; }
/* Complete knowledge profile editor */
.knowledge-sheet {
  max-height: 92vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.knowledge-base-state {
  margin: -8rpx 0 18rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-sm);
  background: rgba(111, 139, 105, 0.12);
  color: #5F795B;
  font-size: 22rpx;
  line-height: 1.55;
}
.knowledge-base-state.missing { background: rgba(176, 122, 84, 0.12); color: #9B6541; }
.knowledge-scroll { height: 72vh; }
.knowledge-section-title {
  margin: 24rpx 0 10rpx;
  color: var(--cocoa);
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.knowledge-field-card {
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: var(--r-sm);
  background: rgba(255, 255, 255, 0.48);
  border: 1rpx solid rgba(201, 184, 173, 0.32);
}
.knowledge-field-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.knowledge-field-label { color: var(--ink2); font-size: 25rpx; font-weight: 600; }
.knowledge-field-badges { display: flex; gap: 8rpx; }
.knowledge-badge { padding: 3rpx 10rpx; border-radius: 999rpx; font-size: 18rpx; }
.knowledge-badge.personal { color: #A65743; background: rgba(194, 91, 69, 0.12); }
.knowledge-badge.locked { color: #5F795B; background: rgba(111, 139, 105, 0.14); }
.knowledge-field-value { margin-top: 10rpx; color: var(--ink); font-size: 27rpx; line-height: 1.45; word-break: break-all; }
.knowledge-field-value.missing { color: var(--ink4); }
.knowledge-field-meta, .knowledge-field-evidence, .knowledge-field-source { margin-top: 8rpx; color: var(--ink4); font-size: 20rpx; line-height: 1.45; word-break: break-all; }
.knowledge-field-evidence { color: var(--ink3); }
.knowledge-inventory-summary { color: var(--ink3); font-size: 24rpx; padding: 12rpx 0; }
.knowledge-inventory-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; border-bottom: 1rpx solid rgba(201, 184, 173, 0.3); color: var(--ink2); font-size: 24rpx; }
.knowledge-add-package { margin-top: 20rpx; }
.knowledge-edit-path { color: var(--cocoa); font-size: 30rpx; font-weight: 600; }
.knowledge-edit-description { margin-top: 12rpx; color: var(--ink3); font-size: 23rpx; line-height: 1.55; }
.knowledge-edit-input { box-sizing: border-box; width: 100%; min-height: 110rpx; margin-top: 24rpx; padding: 20rpx; border-radius: var(--r-sm); background: rgba(255,255,255,.56); color: var(--ink); font-size: 27rpx; }
.knowledge-edit-hint { margin-top: 10rpx; color: var(--ink4); font-size: 21rpx; }
.knowledge-edit-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 28rpx; }
.knowledge-edit-actions .tea-lib-form-btn { min-width: 42%; padding-left: 16rpx; padding-right: 16rpx; }
.knowledge-inventory-empty { padding: 28rpx 20rpx; text-align: center; color: var(--ink4); font-size: 23rpx; border-radius: var(--r-sm); background: rgba(255,255,255,.36); }
.knowledge-inventory-card { margin-bottom: 14rpx; padding: 18rpx 20rpx; border: 1rpx solid rgba(201,184,173,.34); border-radius: var(--r-sm); background: rgba(255,255,255,.5); }
.knowledge-inventory-card.finished { opacity: .72; }
.knowledge-inventory-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.knowledge-inventory-name { color: var(--ink); font-size: 26rpx; font-weight: 600; }
.knowledge-inventory-status { flex-shrink: 0; padding: 4rpx 12rpx; border-radius: 999rpx; color: #5F795B; background: rgba(111,139,105,.14); font-size: 19rpx; }
.knowledge-inventory-card.opened .knowledge-inventory-status { color: #A65743; background: rgba(194,91,69,.12); }
.knowledge-inventory-card.finished .knowledge-inventory-status { color: var(--ink3); background: var(--cream2); }
.knowledge-inventory-detail, .knowledge-inventory-note { margin-top: 9rpx; color: var(--ink3); font-size: 21rpx; line-height: 1.5; }
.knowledge-inventory-note { color: var(--ink4); }
.knowledge-inventory-reminder { margin-top: 10rpx; padding: 10rpx 12rpx; border-radius: 10rpx; color: #9B6541; background: rgba(176,122,84,.11); font-size: 20rpx; }
.knowledge-inventory-actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.knowledge-inventory-action { padding: 9rpx 16rpx; border-radius: 999rpx; color: var(--ink3); background: var(--cream2); font-size: 21rpx; }
.knowledge-inventory-action.primary { color: #A65743; background: rgba(194,91,69,.12); }
.knowledge-inventory-action.danger, .inventory-delete-btn { color: #B05A4A; }
.inventory-edit-scroll { margin-top: 10rpx; }
.inventory-opened-hint { padding: 14rpx 0; color: var(--ink4); font-size: 21rpx; line-height: 1.5; }
.inventory-note-field { align-items: flex-start; }
.inventory-note-input { box-sizing: border-box; flex: 1; min-height: 90rpx; padding: 12rpx; border-radius: var(--r-sm); color: var(--ink); background: rgba(255,255,255,.46); font-size: 25rpx; }
