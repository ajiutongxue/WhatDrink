/* ============================================================
   Tea Library Page — 茶叶库 「暖屿」
   ============================================================ */

/* Toolbar */
.tea-lib-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tea-lib-add-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--r-pill);
  background: var(--coral);
  color: #FFFFFF;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx rgba(222, 130, 96, 0.28);
}

.tea-lib-edit-btn {
  padding: 22rpx 36rpx;
  border-radius: var(--r-pill);
  background: var(--cream);
  color: var(--ink2);
  font-size: 26rpx;
  border: 1rpx solid var(--card-border);
  letter-spacing: 1rpx;
}

.tea-lib-edit-btn.active {
  background: var(--cocoa);
  color: var(--cream);
  border-color: var(--cocoa);
}

/* Filter Bar */
.tea-lib-filter-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.tea-lib-filter-inner {
  display: inline-flex;
  padding: 8rpx 0 16rpx;
}

.tea-lib-filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  margin-right: 16rpx;
  background: var(--cream);
  color: var(--ink3);
  border: 1rpx solid var(--card-border);
  white-space: nowrap;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.tea-lib-filter-item.active {
  background: var(--coral);
  color: #FFFFFF;
  border-color: var(--coral);
}

/* Summary */
.tea-lib-summary {
  font-size: 22rpx;
  color: var(--ink4);
  margin-bottom: 20rpx;
  padding: 0 4rpx;
  letter-spacing: 1rpx;
}

/* Group */
.tea-lib-group {
  margin-bottom: 24rpx;
  padding: 24rpx 0;
}

.tea-lib-cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0 16rpx;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.3);
  margin-bottom: 8rpx;
}

.tea-lib-cat-name {
  font-size: 28rpx;
  color: var(--cocoa);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.tea-lib-cat-count {
  font-size: 22rpx;
  color: var(--ink4);
}

/* Tea Item */
.tea-lib-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.2);
  font-size: 26rpx;
}

.tea-lib-item:last-child {
  border-bottom: none;
}

.tea-lib-item.is-disabled {
  opacity: 0.4;
}

.tea-lib-cat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.tea-lib-name {
  flex: 1;
  font-weight: 400;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 8rpx;
  letter-spacing: 1rpx;
}

.tea-lib-note {
  font-size: 20rpx;
  opacity: 0.6;
}

.tea-lib-disabled-tag {
  font-size: 18rpx;
  color: #FFF;
  background: var(--ink4);
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
}

.tea-lib-props {
  font-size: 22rpx;
  color: var(--ink4);
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.tea-lib-year {
  font-size: 22rpx;
  color: var(--ink4);
}

.tea-lib-caffeine {
  font-size: 22rpx;
  color: var(--ink4);
}

/* Nature mini tag */
.nature-mini-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--r-pill);
  color: #FFFFFF;
}

.nature-mini-tag.nature-han { background: #7FA6C0; }
.nature-mini-tag.nature-liang { background: #8FC0C8; }
.nature-mini-tag.nature-ping { background: #A8A89C; }
.nature-mini-tag.nature-wen { background: #D99A6A; }
.nature-mini-tag.nature-re { background: #CE7A66; }

/* Category dot colors */
.cat-dot-green { background: #8FAE87; }
.cat-dot-black { background: #9C7B6A; }
.cat-dot-white { background: #BCC4BC; }
.cat-dot-oolong_tieguanyin,
.cat-dot-oolong_wuyi,
.cat-dot-oolong_dancong { background: #DE8260; }
.cat-dot-puerh_raw { background: #8FAE87; }
.cat-dot-puerh_ripe { background: #6B5344; }
.cat-dot-flavored_jasmine,
.cat-dot-flavored_other { background: #C98A9A; }

/* Empty */
.tea-lib-empty {
  text-align: center;
  color: var(--ink4);
  padding: 100rpx 40rpx;
  font-size: 28rpx;
}

/* ============================================================
   Edit Mode — Flat List
   ============================================================ */
.tea-lib-flat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 4rpx;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.2);
}

.tea-lib-flat-item.is-disabled {
  opacity: 0.4;
}

.tea-lib-flat-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.tea-lib-flat-info {
  flex: 1;
  min-width: 0;
}

.tea-lib-flat-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 10rpx;
  letter-spacing: 1rpx;
}

.tea-lib-flat-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink4);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tea-lib-flat-cat {
  color: var(--ink4);
}

.tea-lib-flat-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.tea-lib-act {
  width: 52rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink2);
  background: var(--cream2);
  border-radius: var(--r-sm);
}

.tea-lib-act.danger {
  color: #B05A4A;
  background: rgba(200, 120, 110, 0.12);
}

/* ============================================================
   Form Popup
   ============================================================ */
.tea-lib-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(62, 47, 43, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.tea-lib-form {
  width: 100%;
  background: var(--cream);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}

.tea-lib-form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--cocoa);
  text-align: center;
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
}

.tea-lib-field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.3);
}

.tea-lib-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--ink2);
  flex-shrink: 0;
}

.tea-lib-label .req {
  color: #B05A4A;
}

.tea-lib-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.tea-lib-ph {
  color: var(--ink4);
  font-size: 26rpx;
}

.tea-lib-picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.tea-lib-form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.tea-lib-form-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--r-pill);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.tea-lib-form-btn.cancel {
  background: var(--cream2);
  color: var(--ink3);
}

.tea-lib-form-btn.save {
  background: var(--coral);
  color: #FFFFFF;
}
