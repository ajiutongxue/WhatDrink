/* ============================================================
   Tea Library Page — 茶叶库
   ============================================================ */

/* Toolbar */
.tea-lib-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tea-lib-add-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #7A5640, #5C3D2E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(92, 61, 46, 0.18);
}

.tea-lib-edit-btn {
  padding: 20rpx 36rpx;
  border-radius: 40rpx;
  background: #FFFDF9;
  color: #6B4F3A;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #E8DFD0;
}

.tea-lib-edit-btn.active {
  background: #C4793B;
  color: #FFFFFF;
  border-color: #C4793B;
}

/* Filter Bar */
.tea-lib-filter-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.tea-lib-filter-inner {
  display: inline-flex;
  padding: 8rpx 0 16rpx;
}

.tea-lib-filter-item {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  margin-right: 16rpx;
  background: #FFFDF9;
  color: #8A7668;
  border: 2rpx solid #F0EBE3;
  white-space: nowrap;
  flex-shrink: 0;
}

.tea-lib-filter-item.active {
  background: #C4793B;
  color: #FFFFFF;
  border-color: #C4793B;
}

/* Summary */
.tea-lib-summary {
  font-size: 24rpx;
  color: #B5A89A;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

/* Group */
.tea-lib-group {
  margin-bottom: 24rpx;
  background: #FFFDF9;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #F0EBE3;
}

.tea-lib-cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0 16rpx;
  border-bottom: 1rpx solid #F0EBE3;
  margin-bottom: 8rpx;
}

.tea-lib-cat-name {
  font-size: 28rpx;
  color: #6B4F3A;
  font-weight: 600;
}

.tea-lib-cat-count {
  font-size: 22rpx;
  color: #B5A89A;
}

/* Tea Item */
.tea-lib-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #F0EBE3;
  font-size: 26rpx;
}

.tea-lib-item:last-child {
  border-bottom: none;
}

.tea-lib-item.is-disabled {
  opacity: 0.45;
}

.tea-lib-cat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.tea-lib-name {
  flex: 1;
  font-weight: 500;
  color: #3A2A1E;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tea-lib-note {
  font-size: 20rpx;
  opacity: 0.6;
}

.tea-lib-disabled-tag {
  font-size: 18rpx;
  color: #FFFFFF;
  background: #B5A89A;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.tea-lib-props {
  font-size: 22rpx;
  color: #B5A89A;
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.tea-lib-year {
  font-size: 22rpx;
  color: #B5A89A;
}

.tea-lib-caffeine {
  font-size: 22rpx;
  color: #B5A89A;
}

/* Nature mini tag */
.nature-mini-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.nature-mini-tag.nature-han { background: #4A7FB5; }
.nature-mini-tag.nature-liang { background: #6AAFCF; }
.nature-mini-tag.nature-ping { background: #A8A8A8; }
.nature-mini-tag.nature-wen { background: #D4883A; }
.nature-mini-tag.nature-re { background: #C25B45; }

/* Category dot colors */
.cat-dot-green { background: #6A9B5C; }
.cat-dot-black { background: #8D6E63; }
.cat-dot-white { background: #B0BEC5; }
.cat-dot-oolong_tieguanyin,
.cat-dot-oolong_wuyi,
.cat-dot-oolong_dancong { background: #D4943A; }
.cat-dot-puerh_raw { background: #6A9B5C; }
.cat-dot-puerh_ripe { background: #5D4037; }
.cat-dot-flavored_jasmine,
.cat-dot-flavored_other { background: #C27070; }

/* Empty */
.tea-lib-empty {
  text-align: center;
  color: #B5A89A;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
}

/* ============================================================
   Edit Mode — Flat List
   ============================================================ */
.tea-lib-flat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #FFFDF9;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #F0EBE3;
}

.tea-lib-flat-item.is-disabled {
  opacity: 0.5;
}

.tea-lib-flat-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.tea-lib-flat-info {
  flex: 1;
  min-width: 0;
}

.tea-lib-flat-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #3A2A1E;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tea-lib-flat-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #B5A89A;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tea-lib-flat-cat {
  color: #B5A89A;
}

.tea-lib-flat-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.tea-lib-act {
  width: 52rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6B4F3A;
  background: #F0E8DA;
  border-radius: 12rpx;
}

.tea-lib-act.danger {
  color: #C25B45;
  background: #F8E3DE;
}

/* ============================================================
   Form Popup
   ============================================================ */
.tea-lib-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(58, 42, 30, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.tea-lib-form {
  width: 100%;
  background: #FFFDF9;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(107, 79, 58, 0.12);
}

.tea-lib-form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3A2A1E;
  text-align: center;
  margin-bottom: 28rpx;
}

.tea-lib-field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EBE3;
}

.tea-lib-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #6B4F3A;
  flex-shrink: 0;
}

.tea-lib-label .req {
  color: #C25B45;
}

.tea-lib-input {
  flex: 1;
  font-size: 28rpx;
  color: #3A2A1E;
}

.tea-lib-ph {
  color: #C9BFB2;
  font-size: 26rpx;
}

.tea-lib-picker {
  flex: 1;
  font-size: 28rpx;
  color: #3A2A1E;
}

.tea-lib-form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.tea-lib-form-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.tea-lib-form-btn.cancel {
  background: #F0E8DA;
  color: #8A7668;
}

.tea-lib-form-btn.save {
  background: linear-gradient(135deg, #7A5640, #5C3D2E);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(92, 61, 46, 0.18);
}
