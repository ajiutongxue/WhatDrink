/* ============================================================
   Tea Library Page — 茶叶库
   ============================================================ */

/* Filter Bar */
.tea-lib-filter-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.tea-lib-filter-inner {
  display: inline-flex;
  padding: 8rpx 0 16rpx;
}

.tea-lib-filter-item {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  margin-right: 16rpx;
  background: #FFFDF9;
  color: #8A7668;
  border: 2rpx solid #F0EBE3;
  white-space: nowrap;
  flex-shrink: 0;
}

.tea-lib-filter-item.active {
  background: #C4793B;
  color: #FFFFFF;
  border-color: #C4793B;
}

/* Summary */
.tea-lib-summary {
  font-size: 24rpx;
  color: #B5A89A;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

/* Group */
.tea-lib-group {
  margin-bottom: 24rpx;
  background: #FFFDF9;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #F0EBE3;
}

.tea-lib-cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0 16rpx;
  border-bottom: 1rpx solid #F0EBE3;
  margin-bottom: 8rpx;
}

.tea-lib-cat-name {
  font-size: 28rpx;
  color: #6B4F3A;
  font-weight: 600;
}

.tea-lib-cat-count {
  font-size: 22rpx;
  color: #B5A89A;
}

/* Tea Item */
.tea-lib-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #F0EBE3;
  font-size: 26rpx;
}

.tea-lib-item:last-child {
  border-bottom: none;
}

.tea-lib-cat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.tea-lib-name {
  flex: 1;
  font-weight: 500;
  color: #3A2A1E;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tea-lib-note {
  font-size: 20rpx;
  opacity: 0.6;
}

.tea-lib-props {
  font-size: 22rpx;
  color: #B5A89A;
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.tea-lib-year {
  font-size: 22rpx;
  color: #B5A89A;
}

.tea-lib-caffeine {
  font-size: 22rpx;
  color: #B5A89A;
}

/* Nature mini tag */
.nature-mini-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.nature-mini-tag.nature-han { background: #4A7FB5; }
.nature-mini-tag.nature-liang { background: #6AAFCF; }
.nature-mini-tag.nature-ping { background: #A8A8A8; }
.nature-mini-tag.nature-wen { background: #D4883A; }
.nature-mini-tag.nature-re { background: #C25B45; }

/* Category dot colors */
.cat-dot-green { background: #6A9B5C; }
.cat-dot-black { background: #8D6E63; }
.cat-dot-white { background: #B0BEC5; }
.cat-dot-oolong_tieguanyin,
.cat-dot-oolong_wuyi,
.cat-dot-oolong_dancong { background: #D4943A; }
.cat-dot-puerh_raw { background: #6A9B5C; }
.cat-dot-puerh_ripe { background: #5D4037; }
.cat-dot-flavored_jasmine,
.cat-dot-flavored_other { background: #C27070; }

/* Empty */
.tea-lib-empty {
  text-align: center;
  color: #B5A89A;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
}
