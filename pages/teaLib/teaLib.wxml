<view class="page-container">

  <!-- ========== Toolbar ========== -->
  <view class="tea-lib-toolbar">
    <view class="tea-lib-add-btn" bindtap="onAddTea">+ 添加茶叶</view>
    <view class="tea-lib-edit-btn {{editMode ? 'active' : ''}}" bindtap="onToggleEdit">{{editMode ? '完成' : '管理'}}</view>
  </view>

  <!-- ========== Filter Bar (browse mode) ========== -->
  <scroll-view wx:if="{{!editMode}}" class="tea-lib-filter-bar" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="tea-lib-filter-inner">
      <text
        wx:for="{{filterList}}"
        wx:key="key"
        class="tea-lib-filter-item {{item.active ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onFilterTap"
      >{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- ========== Summary ========== -->
  <view class="tea-lib-summary">
    <text>共 {{totalCount}} 款茶叶{{disabledCount > 0 ? '（' + disabledCount + '款已停用）' : ''}}</text>
  </view>

  <!-- ========== Grouped Tea List (browse mode) ========== -->
  <block wx:if="{{!editMode}}" wx:for="{{groupedTeas}}" wx:key="catKey">
    <view class="tea-lib-group">

      <view class="tea-lib-cat-header">
        <text class="tea-lib-cat-name">{{item.catName}}</text>
        <text class="tea-lib-cat-count">{{item.count}}款</text>
      </view>

      <view
        class="tea-lib-item {{tea.disabled ? 'is-disabled' : ''}}"
        wx:for="{{item.teas}}"
        wx:for-item="tea"
        wx:key="id"
        data-id="{{tea.id}}"
        bindtap="onEditTea"
      >
        <view class="tea-lib-cat-dot cat-dot-{{tea.cat}}"></view>
        <view class="tea-lib-name">
          <text>{{tea.name}}</text>
          <text wx:if="{{tea.disabled}}" class="tea-lib-disabled-tag">已停用</text>
          <text wx:if="{{tea.note}}" class="tea-lib-note">⚠</text>
        </view>
        <view class="tea-lib-props">
          <text class="nature-mini-tag nature-{{tea.natureCls}}">{{tea.nature}}</text>
          <text wx:if="{{tea.year}}" class="tea-lib-year">{{tea.year}}年</text>
          <text class="tea-lib-caffeine">☕{{tea.caffeine}}</text>
          <text class="tea-lib-knowledge {{tea.knowledgeMissing ? 'missing' : ''}}">{{tea.knowledgeLabel}}</text>
          <text wx:if="{{tea.inventorySummary}}" class="tea-lib-inventory">{{tea.inventorySummary}}</text>
        </view>
      </view>

    </view>
  </block>

  <!-- ========== Empty (browse mode) ========== -->
  <view class="tea-lib-empty" wx:if="{{!editMode && groupedTeas.length === 0}}">
    <text>该分类下暂无茶叶</text>
  </view>

  <!-- ========== Flat List (edit mode) ========== -->
  <block wx:if="{{editMode}}">
    <view
      class="tea-lib-flat-item {{item.disabled ? 'is-disabled' : ''}}"
      wx:for="{{flatTeas}}"
      wx:key="id"
    >
      <view class="tea-lib-flat-main">
        <view class="tea-lib-cat-dot cat-dot-{{item.cat}}"></view>
        <view class="tea-lib-flat-info">
          <view class="tea-lib-flat-name">
            <text>{{item.name}}</text>
            <text wx:if="{{item.disabled}}" class="tea-lib-disabled-tag">已停用</text>
            <text wx:if="{{item.note}}" class="tea-lib-note">⚠</text>
          </view>
          <view class="tea-lib-flat-sub">
            <text class="nature-mini-tag nature-{{item.natureCls}}">{{item.nature}}</text>
            <text wx:if="{{item.year}}" class="tea-lib-year">{{item.year}}年</text>
            <text class="tea-lib-caffeine">☕{{item.caffeine}}</text>
            <text class="tea-lib-flat-cat">{{item.catName}}</text>
            <text class="tea-lib-knowledge {{item.knowledgeMissing ? 'missing' : ''}}">{{item.knowledgeLabel}}</text>
            <text wx:if="{{item.inventorySummary}}" class="tea-lib-inventory">{{item.inventorySummary}}</text>
          </view>
        </view>
      </view>
      <view class="tea-lib-flat-actions">
        <view class="tea-lib-act" data-id="{{item.id}}" bindtap="onMoveUp">↑</view>
        <view class="tea-lib-act" data-id="{{item.id}}" bindtap="onMoveDown">↓</view>
        <view class="tea-lib-act" data-id="{{item.id}}" bindtap="onEditTea">编</view>
        <view class="tea-lib-act" data-id="{{item.id}}" bindtap="onToggleDisable">{{item.disabled ? '启' : '停'}}</view>
        <view class="tea-lib-act danger" data-id="{{item.id}}" bindtap="onDeleteTea">删</view>
      </view>
    </view>
    <view class="tea-lib-empty" wx:if="{{flatTeas.length === 0}}">
      <text>茶库为空，点击上方添加</text>
    </view>
  </block>

</view>

<!-- ========== Add / Edit Form Popup ========== -->
<view wx:if="{{showForm}}" class="tea-lib-mask" bindtap="onFormCancel">
  <view class="tea-lib-form" catchtap="onStopPropagation">

    <view class="tea-lib-form-title">{{formTitle}}</view>

    <view class="tea-lib-field">
      <text class="tea-lib-label">茶名 <text class="req">*</text></text>
      <input class="tea-lib-input" value="{{form.name}}" bindinput="onNameInput" placeholder="如 蒙顶雪芽" placeholder-class="tea-lib-ph" />
    </view>

    <view class="tea-lib-field">
      <text class="tea-lib-label">品牌</text>
      <input class="tea-lib-input" value="{{form.brand}}" bindinput="onBrandInput" placeholder="选填" placeholder-class="tea-lib-ph" />
    </view>

    <view class="tea-lib-field">
      <text class="tea-lib-label">茶类</text>
      <picker bindchange="onCatChange" value="{{catIndex}}" range="{{catOptionNames}}">
        <view class="tea-lib-picker">{{catOptionNames[catIndex]}}</view>
      </picker>
    </view>

    <view class="tea-lib-field">
      <text class="tea-lib-label">年份</text>
      <input class="tea-lib-input" type="number" value="{{form.year}}" bindinput="onYearInput" bindblur="onYearBlur" placeholder="选填，如 2023" placeholder-class="tea-lib-ph" />
    </view>

    <view class="tea-lib-field">
      <text class="tea-lib-label">茶性</text>
      <picker bindchange="onNatureChange" value="{{natureIndex}}" range="{{natureOptionNames}}">
        <view class="tea-lib-picker">{{natureOptionNames[natureIndex]}}</view>
      </picker>
    </view>

    <view class="tea-lib-field">
      <text class="tea-lib-label">咖啡因</text>
      <picker bindchange="onCaffeineChange" value="{{caffeineIndex}}" range="{{caffeineOptionNames}}">
        <view class="tea-lib-picker">{{caffeineOptionNames[caffeineIndex]}}</view>
      </picker>
    </view>

    <view class="tea-lib-field">
      <text class="tea-lib-label">备注</text>
      <input class="tea-lib-input" value="{{form.note}}" bindinput="onNoteInput" placeholder="选填，如 疑似假货" placeholder-class="tea-lib-ph" />
    </view>

    <view class="tea-lib-field tea-lib-avoid-field" wx:if="{{formType === 'edit'}}">
      <view class="tea-lib-avoid-copy">
        <text class="tea-lib-label tea-lib-avoid-label">暂时不想喝</text>
        <text class="tea-lib-avoid-hint">开启后 30 天内不参与推荐</text>
      </view>
      <switch checked="{{form.temporarilyAvoided}}" bindchange="onAvoidChange" color="#C25B45" />
    </view>

    <view wx:if="{{formType === 'edit'}}" class="tea-lib-form-btn cancel" bindtap="onOpenKnowledge">画像与库存</view>
    <view class="tea-lib-form-actions">
      <view class="tea-lib-form-btn cancel" bindtap="onFormCancel">取消</view>
      <view class="tea-lib-form-btn save" bindtap="onFormSave">保存</view>
    </view>

  </view>
</view>

<view wx:if="{{showKnowledge}}" class="tea-lib-mask" bindtap="onKnowledgeClose">
  <view class="tea-lib-form knowledge-sheet" catchtap="onStopPropagation">
    <view class="tea-lib-form-title">{{knowledgeTeaName}} · 画像与库存</view>

    <block wx:if="{{!knowledgeFieldEditing && !inventoryEditing}}">
      <view class="knowledge-base-state {{knowledgeHasBase ? '' : 'missing'}}">{{knowledgeHasBase ? '基础画像已安装；个人修改不会覆盖基础资料' : '暂无完整基础画像；已显示当前茶库中的名称、品牌、茶类和年份，可继续个人补录'}}</view>
      <scroll-view class="knowledge-scroll" scroll-y enable-flex>
        <block wx:for="{{knowledgeSections}}" wx:key="name" wx:for-item="section">
          <view class="knowledge-section-title">{{section.label}}</view>
          <view wx:for="{{section.fields}}" wx:key="path" wx:for-item="field" class="knowledge-field-card" bindtap="onKnowledgeFieldTap" data-path="{{field.path}}">
            <view class="knowledge-field-head">
              <text class="knowledge-field-label">{{field.label}}</text>
              <view class="knowledge-field-badges"><text wx:if="{{field.overridden}}" class="knowledge-badge personal">个人</text><text wx:if="{{field.locked}}" class="knowledge-badge locked">已锁定</text></view>
            </view>
            <view class="knowledge-field-value {{field.valueText === '待补充' ? 'missing' : ''}}">{{field.valueText}}</view>
            <view class="knowledge-field-meta">{{field.statusLabel}} · {{field.sourceLabel}} · 可信度 {{field.confidenceText}}</view>
            <view wx:if="{{field.evidence}}" class="knowledge-field-evidence">依据：{{field.evidence}}</view>
            <view wx:for="{{field.sourceRefs}}" wx:key="*this" wx:for-item="ref" class="knowledge-field-source">来源：{{ref}}</view>
          </view>
        </block>

        <view class="knowledge-section-title">库存包装</view>
        <view class="knowledge-inventory-summary">库存记录 {{inventoryItems.length}} 条；已喝完记录不计入茶库库存摘要</view>
        <view wx:if="{{!inventoryItems.length}}" class="knowledge-inventory-empty">还没有包装记录</view>
        <view wx:for="{{inventoryItems}}" wx:key="id" class="knowledge-inventory-card {{item.status}}">
          <view class="knowledge-inventory-head"><text class="knowledge-inventory-name">{{item.packageLabel}}</text><text class="knowledge-inventory-status">{{item.statusLabel}}</text></view>
          <view class="knowledge-inventory-detail">{{item.detailText}}</view>
          <view wx:if="{{item.note}}" class="knowledge-inventory-note">备注：{{item.note}}</view>
          <view wx:if="{{item.reminderText}}" class="knowledge-inventory-reminder">{{item.reminderText}}</view>
          <view class="knowledge-inventory-actions">
            <view class="knowledge-inventory-action" catchtap="onInventoryEdit" data-id="{{item.id}}">编辑</view>
            <view wx:if="{{item.canOpen}}" class="knowledge-inventory-action primary" catchtap="onInventoryOpen" data-id="{{item.id}}">开封一包</view>
            <view wx:if="{{item.canConsume}}" class="knowledge-inventory-action primary" catchtap="onInventoryConsume" data-id="{{item.id}}">喝一泡</view>
            <view wx:if="{{item.canFinish}}" class="knowledge-inventory-action" catchtap="onInventoryFinish" data-id="{{item.id}}">喝完</view>
            <view class="knowledge-inventory-action danger" catchtap="onInventoryDelete" data-id="{{item.id}}">删除</view>
          </view>
        </view>
        <view class="tea-lib-form-btn cancel knowledge-add-package" bindtap="onInventoryCreate">新增包装</view>
        <view class="tea-lib-form-actions"><view class="tea-lib-form-btn cancel" bindtap="onKnowledgeClose">关闭</view></view>
      </scroll-view>
    </block>

    <block wx:elif="{{inventoryEditing}}">
      <view class="knowledge-edit-path">{{inventoryFormTitle}}</view>
      <scroll-view class="knowledge-scroll inventory-edit-scroll" scroll-y enable-flex>
        <view class="tea-lib-field"><text class="tea-lib-label">包装类型</text><picker bindchange="onInventoryPackageTypeChange" value="{{inventoryPackageTypeIndex}}" range="{{inventoryPackageTypeOptions}}"><view class="tea-lib-picker">{{inventoryPackageTypeOptions[inventoryPackageTypeIndex]}}</view></picker></view>
        <view class="tea-lib-field"><text class="tea-lib-label">包装名称</text><input class="tea-lib-input" value="{{inventoryForm.packageLabel}}" bindinput="onInventoryLabelInput" placeholder="如 3g 试饮装、100g 袋装" /></view>
        <view class="tea-lib-field"><text class="tea-lib-label">状态</text><view wx:if="{{inventoryForm.id && inventoryForm.status !== 'unknown'}}" class="tea-lib-picker">{{inventoryStatusOptions[inventoryStatusIndex]}}（请用状态操作修改）</view><picker wx:else bindchange="onInventoryStatusChange" value="{{inventoryStatusIndex}}" range="{{inventoryStatusOptions}}"><view class="tea-lib-picker">{{inventoryStatusOptions[inventoryStatusIndex]}}</view></picker></view>
        <view wx:if="{{inventoryForm.status === 'sealed'}}" class="tea-lib-field"><text class="tea-lib-label">数量</text><input class="tea-lib-input" type="number" value="{{inventoryForm.quantity}}" bindinput="onInventoryQuantityInput" placeholder="1" /></view>
        <view class="tea-lib-field"><text class="tea-lib-label">每份克数</text><input class="tea-lib-input" type="digit" value="{{inventoryForm.netWeightPerUnit}}" bindinput="onInventoryNetWeightInput" placeholder="选填" /></view>
        <block wx:if="{{inventoryForm.status !== 'sealed'}}">
          <view class="tea-lib-field"><text class="tea-lib-label">剩余克数</text><input class="tea-lib-input" type="digit" value="{{inventoryForm.remainingWeight}}" bindinput="onInventoryRemainingWeightInput" placeholder="可与泡数二选一" /></view>
          <view class="tea-lib-field"><text class="tea-lib-label">剩余泡数</text><input class="tea-lib-input" type="number" value="{{inventoryForm.remainingSessions}}" bindinput="onInventoryRemainingSessionsInput" placeholder="可与克数二选一" /></view>
          <view wx:if="{{inventoryForm.openedAt}}" class="inventory-opened-hint">开封时间已记录；通过“开封一包”操作会自动写入当前时间。</view>
        </block>
        <view class="tea-lib-field"><text class="tea-lib-label">SKU / 货号</text><input class="tea-lib-input" value="{{inventoryForm.sku}}" bindinput="onInventorySkuInput" placeholder="选填，仅属于该包装" /></view>
        <view class="tea-lib-field"><text class="tea-lib-label">购买链接</text><input class="tea-lib-input" value="{{inventoryForm.purchaseUrl}}" bindinput="onInventoryPurchaseUrlInput" placeholder="https://…" /></view>
        <view class="tea-lib-field inventory-note-field"><text class="tea-lib-label">备注</text><textarea class="inventory-note-input" value="{{inventoryForm.note}}" bindinput="onInventoryNoteInput" placeholder="包装、购买或剩余量说明" auto-height maxlength="500" /></view>
        <view class="knowledge-edit-actions">
          <view class="tea-lib-form-btn cancel" bindtap="onInventoryBack">返回</view>
          <view wx:if="{{inventoryForm.id}}" class="tea-lib-form-btn cancel inventory-delete-btn" bindtap="onInventoryDelete" data-id="{{inventoryForm.id}}">删除</view>
          <view class="tea-lib-form-btn save" bindtap="onInventoryFormSave">保存</view>
        </view>
      </scroll-view>
    </block>

    <block wx:else>
      <view class="knowledge-edit-path">{{knowledgeEditLabel}}</view>
      <view class="knowledge-edit-description">{{knowledgeEditDescription}}</view>
      <textarea class="knowledge-edit-input" value="{{knowledgeEditValue}}" bindinput="onKnowledgeFieldInput" placeholder="{{knowledgeEditHint}}" auto-height maxlength="500" />
      <view class="knowledge-edit-hint">{{knowledgeEditHint}}</view>
      <view class="tea-lib-field tea-lib-avoid-field"><text class="tea-lib-label">锁定此项</text><switch checked="{{knowledgeEditLocked}}" bindchange="onKnowledgeEditLockChange" color="#C25B45" /></view>
      <view class="knowledge-edit-actions">
        <view class="tea-lib-form-btn cancel" bindtap="onKnowledgeBackToList">返回</view>
        <view wx:if="{{knowledgeEditCanClear}}" class="tea-lib-form-btn cancel" bindtap="onKnowledgeFieldClear">清空值</view>
        <view wx:if="{{knowledgeEditOverridden}}" class="tea-lib-form-btn cancel" bindtap="onKnowledgeFieldRestore">恢复基础</view>
        <view class="tea-lib-form-btn save" bindtap="onKnowledgeFieldSave">保存</view>
      </view>
    </block>
  </view>
</view>