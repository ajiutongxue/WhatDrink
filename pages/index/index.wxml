<!-- SVG Full-page Background (fixed, behind everything) -->
<image class="scene-bg" src="/images/scene-{{scene}}.svg" mode="aspectFill" />

<view class="page-container">

  <!-- ========== Date Typography (seamless, no container) ========== -->
  <view class="date-block" style="padding-top: {{statusBarHeight + 48}}px">
    <view class="date-row">
      <text class="date-day">{{day}}</text>
      <view class="date-meta">
        <text class="date-term" wx:if="{{solarTerm}}">{{solarTerm}}</text>
        <text class="date-sub">{{week}} · 农历{{lunarDate}}</text>
      </view>
    </view>
    <text class="date-weather" wx:if="{{weather}}">{{weather.city}} {{weather.temp}}° · 湿度{{weather.humidity}}%</text>
  </view>

  <!-- ========== Input Zone ========== -->
  <!-- Hidden state: invisible tap area, shows summary if text exists -->
  <view class="input-zone" bindtap="onShowInput" wx:if="{{!showInput}}">
    <text class="input-summary" wx:if="{{inputValue}}">{{inputValue}}</text>
  </view>

  <!-- Glass input: pure textarea, no chrome -->
  <view class="glass-input" wx:if="{{showInput}}">
    <textarea
      class="glass-textarea"
      value="{{inputValue}}"
      bindinput="onInput"
      maxlength="500"
      auto-height
      focus="{{showInput}}"
    />
    <view class="parsed-tags" wx:if="{{parsedTags.length > 0}}">
      <block wx:for="{{parsedTags}}" wx:key="index">
        <text class="tag tag-{{item.type}}">{{item.icon}} {{item.label}}</text>
      </block>
    </view>
  </view>

  <!-- ========== Recommend Button ========== -->
  <button class="btn-rec" bindtap="onRecommend" disabled="{{loading}}">{{btnText}}</button>

  <!-- ========== Recommendation Area ========== -->
  <view id="rec-area">

    <!-- Loading State -->
    <view class="rec-hero ai-loading" wx:if="{{loading}}">
      <view class="ai-loading-icon">🧠</view>
      <view class="ai-loading-text">{{loadingText}}<text class="ai-loading-dots">...</text></view>
      <view class="ai-loading-sub">综合时令、天气与中医茶疗理论</view>
      <view class="ai-cancel" wx:if="{{showCancel}}" bindtap="onCancelLLM">等太久了？取消，改用规则推荐</view>
    </view>

    <!-- No Result -->
    <view class="rec-hero no-result" wx:if="{{noResult}}">
      <view class="no-result-icon">🤔</view>
      <view class="no-result-text">没有合适的茶推荐</view>
      <view class="no-result-hint">试试放宽条件？</view>
    </view>

    <!-- Recommendation Result -->
    <view class="rec-section" wx:if="{{hasResult && !loading}}">

      <!-- ===== Primary Recommendation ===== -->
      <view class="rec-hero">
        <text class="rec-hero-badge ai" wx:if="{{rec.isAI}}">AI 推荐</text>
        <text class="rec-hero-badge primary" wx:else>本地算法推荐</text>

        <view class="ai-notice" wx:if="{{rec.isAI}}">
          <text>✨ {{rec.aiModel}} 深度分析</text>
        </view>

        <view class="rec-hero-name">{{rec.primary.name}}</view>
        <view class="rec-hero-tagline" wx:if="{{rec.primary.tagline}}">{{rec.primary.tagline}}</view>
        <view class="rec-hero-brand">{{rec.primary.brand}}</view>

        <view class="rec-hero-tags">
          <text class="nature-tag nature-{{rec.primary.natureCls}}">{{rec.primary.nature}}性</text>
          <text class="rec-hero-tag cat-tag">{{rec.primary.catName}}</text>
          <text class="rec-hero-tag info-tag">咖啡因 {{rec.primary.caffeine}}</text>
          <text class="rec-hero-tag info-tag" wx:if="{{rec.primary.year}}">{{rec.primary.year}}年</text>
        </view>

        <!-- AI Reasons -->
        <view class="rec-reasons" wx:if="{{rec.isAI && rec.primary.reasons.length > 0}}">
          <view class="rec-reason-item" wx:for="{{rec.primary.reasons}}" wx:key="index">
            <text class="rec-reason-dot"></text>
            <text class="rec-reason-text">{{item}}</text>
          </view>
        </view>
        <!-- Rule-based Reason -->
        <view class="rec-hero-reason" wx:if="{{!rec.isAI}}">
          <text>{{rec.primary.reason}}</text>
        </view>

        <!-- Taste Note -->
        <view class="rec-taste" wx:if="{{rec.primary.taste_note}}">
          <text class="rec-taste-label">品饮感受</text>
          <text class="rec-taste-text">{{rec.primary.taste_note}}</text>
        </view>

        <!-- Brew Guide -->
        <view class="rec-hero-brew">
          <text>{{rec.primary.brew.temp}}</text>
          <text>{{rec.primary.brew.ratio}}</text>
          <text>{{rec.primary.brew.time}}</text>
        </view>
        <view class="rec-brew-tip" wx:if="{{rec.primary.brew_tip}}">
          <text>{{rec.primary.brew_tip}}</text>
        </view>

        <!-- Best Before & Pairing -->
        <view class="rec-extra-hints" wx:if="{{rec.primary.best_before || rec.primary.pairing}}">
          <view class="rec-hint-line" wx:if="{{rec.primary.best_before}}">
            <text>{{rec.primary.best_before}}</text>
          </view>
          <view class="rec-hint-line" wx:if="{{rec.primary.pairing}}">
            <text>{{rec.primary.pairing}}</text>
          </view>
        </view>

        <!-- Avoid Info -->
        <view class="avoid-info" wx:if="{{rec.avoidInfo}}">
          <text>{{rec.avoidInfo}}</text>
        </view>
      </view>

      <!-- ===== Alternative ===== -->
      <view class="rec-alt" wx:if="{{rec.alt}}">
        <view class="rec-alt-icon">
          <text>{{rec.alt.icon}}</text>
        </view>
        <view class="rec-alt-body">
          <text class="rec-alt-badge">{{rec.isAI ? 'AI 备选' : '备选'}}</text>
          <view>
            <text class="rec-alt-name">{{rec.alt.name}}</text>
            <text class="rec-alt-brand">{{rec.alt.brand}}</text>
          </view>
          <view class="rec-alt-tags">
            <text class="nature-tag nature-{{rec.alt.natureCls}}" style="font-size:20rpx;padding:2rpx 12rpx">{{rec.alt.nature}}性</text>
            <text class="rec-hero-tag cat-tag" style="font-size:20rpx">{{rec.alt.catName}}</text>
          </view>
          <view class="rec-alt-why" wx:if="{{rec.alt.why_different}}">
            <text>{{rec.alt.why_different}}</text>
          </view>
          <view class="rec-alt-reasons" wx:if="{{rec.isAI && rec.alt.reasons.length > 0}}">
            <text class="rec-alt-reason-line" wx:for="{{rec.alt.reasons}}" wx:key="index">{{item}}</text>
          </view>
          <view class="rec-alt-reason" wx:if="{{!rec.isAI && rec.alt.reason}}">
            <text>{{rec.alt.reason}}</text>
          </view>
          <view class="rec-alt-brew-tip" wx:if="{{rec.alt.brew_tip}}">
            <text>{{rec.alt.brew_tip}}</text>
          </view>
          <view class="rec-alt-brew" wx:if="{{rec.alt.brew}}">
            <text>{{rec.alt.brew.temp}} · {{rec.alt.brew.ratio}}</text>
          </view>
        </view>
      </view>

      <!-- ===== Checkin ===== -->
      <view class="checkin-card" wx:if="{{!checkedIn}}">
        <view class="checkin-title">今天喝了什么</view>
        <view class="checkin-row">
          <button class="checkin-pill hero" bindtap="onCheckinPrimary">{{rec.primary.name}}</button>
          <button class="checkin-pill secondary" wx:if="{{rec.alt}}" bindtap="onCheckinAlt">{{rec.alt.name}}</button>
          <button class="checkin-pill muted" bindtap="onShowCustom">喝的别的</button>
          <button class="checkin-pill muted" bindtap="onSkipToday">没喝</button>
        </view>
        <view class="checkin-custom" wx:if="{{showCustom}}">
          <input
            value="{{customTeaName}}"
            bindinput="onCustomInput"
            placeholder="茶名"
            confirm-type="done"
            bindconfirm="onCheckinCustom"
          />
          <button class="checkin-custom-btn" bindtap="onCheckinCustom">记录</button>
        </view>
      </view>

      <!-- Already checked in -->
      <view class="checkin-card" wx:if="{{checkedIn}}">
        <view class="checkin-title">今日打卡完成 ✓</view>
        <view class="checkin-done-text">{{checkinMsg}}</view>

        <block wx:if="{{!isSkip}}">
          <view class="tasting-entry" wx:if="{{!showTasting}}">
            <text class="tasting-trigger" bindtap="onShowTasting">写几句品饮感受</text>
          </view>
          <view class="tasting-entry" wx:if="{{showTasting}}">
            <textarea
              class="tasting-textarea"
              value="{{tastingDraft}}"
              bindinput="onTastingInput"
              placeholder="口感、香气、回甘、体感、心情..."
              maxlength="500"
              auto-height
              focus="{{showTasting}}"
            />
            <view class="tasting-img-grid" wx:if="{{tastingImages.length > 0}}">
              <view class="tasting-img-item" wx:for="{{tastingImages}}" wx:key="fileID">
                <image class="tasting-img-thumb" src="{{item.fileID}}" mode="aspectFill" data-src="{{item.fileID}}" bindtap="onPreviewImage"></image>
                <view class="tasting-img-del" data-idx="{{index}}" catchtap="onRemoveImage">×</view>
                <input class="tasting-img-caption" value="{{item.caption}}" data-idx="{{index}}" bindinput="onCaptionInput" placeholder="说明" maxlength="40" />
              </view>
            </view>
            <view class="tasting-img-add" wx:if="{{tastingImages.length < 6}}" bindtap="onChooseImage">
              <text class="tasting-img-add-icon">+</text>
              <text class="tasting-img-add-text">{{tastingImages.length}}/6</text>
            </view>
            <view class="tasting-actions">
              <text class="tasting-count">{{tastingDraft.length}}/500</text>
              <button class="tasting-save-btn" bindtap="onSaveTasting">保存</button>
            </view>
          </view>
          <view class="tasting-saved" wx:if="{{tastingSaved}}">
            <text class="tasting-saved-text" wx:if="{{tastingSavedText}}">{{tastingSavedText}}</text>
            <view class="tasting-img-grid" wx:if="{{tastingImages.length > 0}}">
              <view class="tasting-img-saved-item" wx:for="{{tastingImages}}" wx:key="fileID">
                <image class="tasting-img-thumb" src="{{item.fileID}}" mode="aspectFill" data-src="{{item.fileID}}" bindtap="onPreviewImage"></image>
                <text class="tasting-img-caption-text" wx:if="{{item.caption}}">{{item.caption}}</text>
              </view>
            </view>
            <text class="tasting-edit-link" bindtap="onShowTasting">修改</text>
          </view>
        </block>
      </view>

    </view>
  </view>

  <!-- ========== 页脚版本号 ========== -->
  <view class="page-footer">
    <text class="footer-rule left"></text>
    <text class="footer-ver">v{{version}}</text>
    <text class="footer-rule right"></text>
  </view>

</view>
