  margin-bottom: 0;
}

.rec-reason-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--coral);
  flex-shrink: 0;
  margin-top: 16rpx;
}

.rec-reason-text {
  font-size: 27rpx;
  color: var(--ink2);
  line-height: 1.8;
}

/* Taste note */
