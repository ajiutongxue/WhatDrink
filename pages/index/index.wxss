/* ============================================================
   Index Page — 今日推荐
   文人画卷：背景即设计，界面消隐于山水
   ============================================================ */

/* ========== SVG Full-page Background ========== */
.scene-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
}

/* ========== Date Typography — floats on background ========== */
.date-block {
  padding-bottom: 48rpx;
}

.date-row {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
}

.date-day {
  font-size: 140rpx;
  font-weight: 300;
  color: var(--ink);
  line-height: 0.85;
  letter-spacing: -4rpx;
}

.date-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-bottom: 12rpx;
}

.date-term {
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 4rpx;
  font-weight: 400;
}

.date-sub {
  font-size: 24rpx;
  color: var(--ink3);
  letter-spacing: 2rpx;
}

.date-weather {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--ink4);
  letter-spacing: 2rpx;
}

/* ========== Input Zone — invisible until tapped ========== */
.input-zone {
  min-height: 100rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.input-summary {
  font-size: 26rpx;
  color: var(--ink3);
  line-height: 1.8;
  letter-spacing: 1rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ========== Glass Input — pure frosted panel ========== */
.glass-input {
  margin-bottom: 24rpx;
  padding: 32rpx 36rpx;
  background: var(--glass);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-lg);
  animation: glassReveal 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes glassReveal {
  from { opacity: 0; transform: translateY(-12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.glass-textarea {
  width: 100%;
  min-height: 120rpx;
  border: none;
  background: transparent;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.8;
  letter-spacing: 1rpx;
  box-sizing: border-box;
}

/* ========== Recommend Button ========== */
.btn-rec {
  width: 100%;
  padding: 26rpx;
  border: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: var(--r-md);
  background: rgba(255, 253, 248, 0.5);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  color: var(--ink2);
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 6rpx;
  margin-bottom: 40rpx;
}

.btn-rec[disabled] {
  opacity: 0.4;
}

.btn-rec::after {
  border: none;
}

/* ========== No Result ========== */
.no-result {
  text-align: center;
  padding: 80rpx 44rpx;
}

.no-result-icon {
  font-size: 56rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.no-result-text {
  font-size: 28rpx;
  color: var(--ink2);
  letter-spacing: 2rpx;
}

.no-result-hint {
  font-size: 24rpx;
  margin-top: 12rpx;
  color: var(--ink4);
}

/* ========== AI Loading Dots ========== */
.ai-loading-dots {
  display: inline-block;
  animation: dots 1.2s steps(4, end) infinite;
  width: 30rpx;
  text-align: left;
  overflow: hidden;
  vertical-align: bottom;
}

@keyframes dots {
  0% { width: 0; }
  25% { width: 10rpx; }
  50% { width: 20rpx; }
  75% { width: 30rpx; }
  100% { width: 30rpx; }
}

/* ========== AI Loading 取消按钮 ========== */
.ai-loading {
  text-align: center;
}

.ai-cancel {
  display: inline-block;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--ink3);
  letter-spacing: 2rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: 36rpx;
  transition: all 0.25s ease;
}

.ai-cancel:active {
  color: var(--rose);
  border-color: var(--rose);
  transform: scale(0.96);
}

/* ============================================================
   AI Recommendation — Extended Fields
   ============================================================ */

.rec-hero-tagline {
  font-size: 26rpx;
  color: var(--gold);
  font-weight: 400;
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}

/* Structured reasons (AI) */
.rec-reasons {
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--gold);
}

.rec-reason-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.rec-reason-item:last-child {
  margin-bottom: 0;
}

.rec-reason-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold);
  flex-shrink: 0;
  margin-top: 16rpx;
}

.rec-reason-text {
  font-size: 27rpx;
  color: var(--ink2);
  line-height: 1.8;
}

/* Taste note */
.rec-taste {
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--sage);
}

.rec-taste-label {
  display: block;
  font-size: 22rpx;
  color: var(--ink4);
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
}

.rec-taste-text {
  font-size: 27rpx;
  color: var(--ink2);
  line-height: 1.8;
}

/* Brew tip */
.rec-brew-tip {
  font-size: 24rpx;
  color: var(--ink3);
  margin-top: 16rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}

/* Extra hints */
.rec-extra-hints {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(176, 164, 148, 0.2);
}

.rec-hint-line {
  font-size: 24rpx;
  color: var(--ink3);
  margin-bottom: 10rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.rec-hint-line:last-child {
  margin-bottom: 0;
}

/* Alt: why different */
.rec-alt-why {
  font-size: 24rpx;
  color: var(--gold);
  margin: 12rpx 0 8rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}

/* Alt: structured reasons */
.rec-alt-reasons {
  margin-top: 8rpx;
}

.rec-alt-reason-line {
  display: block;
  font-size: 24rpx;
  color: var(--ink3);
  line-height: 1.8;
  padding-left: 20rpx;
  position: relative;
  margin-bottom: 6rpx;
}

.rec-alt-reason-line::before {
  content: '·';
  position: absolute;
  left: 4rpx;
  color: var(--ink4);
}

/* Alt: brew tip */
.rec-alt-brew-tip {
  font-size: 22rpx;
  color: var(--ink4);
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ============================================================
   Checkin & Tasting Notes
   ============================================================ */
.checkin-done-text {
  font-size: 26rpx;
  color: var(--ink3);
  line-height: 1.8;
}

.tasting-entry {
  margin-top: 24rpx;
}

.tasting-trigger {
  display: inline-block;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 2rpx;
  padding: 8rpx 0;
}

.tasting-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 1rpx solid rgba(176, 164, 148, 0.3);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: rgba(255, 253, 248, 0.4);
  line-height: 1.8;
  box-sizing: border-box;
}

.tasting-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.tasting-count {
  font-size: 22rpx;
  color: var(--ink4);
}

.tasting-save-btn {
  padding: 12rpx 32rpx;
  border: none;
  border-radius: var(--r-md);
  background: var(--ink);
  color: #FDFBF7;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.tasting-save-btn::after {
  border: none;
}

.tasting-saved {
  margin-top: 24rpx;
  padding: 20rpx 0;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--gold);
}

.tasting-saved-text {
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.8;
  display: block;
}

.tasting-edit-link {
  font-size: 22rpx;
  color: var(--gold);
  margin-top: 12rpx;
  display: inline-block;
  letter-spacing: 2rpx;
}

.tasting-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tasting-img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.tasting-img-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-sm);
  background: rgba(176, 164, 148, 0.1);
}

.tasting-img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(44, 36, 24, 0.6);
  color: #FDFBF7;
  border-radius: 50%;
  font-size: 24rpx;
}

.tasting-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border: 1rpx dashed rgba(176, 164, 148, 0.5);
  border-radius: var(--r-sm);
  background: rgba(255, 253, 248, 0.3);
}

.tasting-img-add-icon {
  font-size: 48rpx;
  color: var(--ink4);
  line-height: 1;
}

.tasting-img-add-text {
  font-size: 20rpx;
  color: var(--ink4);
  margin-top: 8rpx;
}

.tasting-img-caption {
  width: 200rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink);
  border: 1rpx solid rgba(176, 164, 148, 0.3);
  border-radius: var(--r-sm);
  padding: 4rpx 8rpx;
  text-align: center;
  background: transparent;
}

.tasting-img-saved-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tasting-img-caption-text {
  width: 200rpx;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink4);
  text-align: center;
  line-height: 1.4;
  word-break: break-all;
}

/* ============================================================
   页脚版本号 — 画卷收笔，轻点即止
   ============================================================ */
.page-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 56rpx 0 16rpx;
}

.footer-rule {
  width: 72rpx;
  height: 1rpx;
}

.footer-rule.left {
  background: linear-gradient(to right, transparent, rgba(176, 164, 148, 0.55));
}

.footer-rule.right {
  background: linear-gradient(to left, transparent, rgba(176, 164, 148, 0.55));
}

.footer-ver {
  font-size: 20rpx;
  color: var(--ink4);
  letter-spacing: 4rpx;
  opacity: 0.75;
}
