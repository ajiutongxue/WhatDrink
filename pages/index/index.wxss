}

.rec-taste-text {
  font-size: 27rpx;
  color: var(--ink2);
  line-height: 1.8;
}

/* Brew tip */
.rec-brew-tip {
  font-size: 24rpx;
  color: var(--ink3);
  margin-top: 16rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}

/* Extra hints */
