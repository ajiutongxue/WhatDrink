/* ============================================================
   Index Page — 今日推荐 「暖屿」
   柔和粉彩 + 印章点缀 + 手写体标题，像一张温暖的茶笺
   ============================================================ */

/* ========== SVG Full-page Background ========== */
.scene-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
}

/* ========== Hero Header ========== */
.hero {
  padding-bottom: 40rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

/* Solar-term seal (印章) */
.seal {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--coral);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(222, 130, 96, 0.32);
  border: 3rpx solid rgba(255, 255, 255, 0.4);
}

.seal-text {
  color: #FFF;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-weather {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  background: var(--card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 12rpx 22rpx;
  border-radius: var(--r-pill);
  border: 1rpx solid var(--card-border);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", "Segoe UI", sans-serif;
}

.hw-main {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.hw-temp {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--coral);
  letter-spacing: 1rpx;
}

.hw-desc {
  font-size: 24rpx;
  color: var(--ink2);
  letter-spacing: 1rpx;
}

.hw-sub {
  font-size: 20rpx;
  color: var(--ink3);
  letter-spacing: 1rpx;
}

/* Big date — serif, bold, orderly */
.hero-date {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-bottom: 28rpx;
}

.hero-day {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 160rpx;
  font-weight: 700;
  color: var(--cocoa);
  line-height: 1;
  letter-spacing: 0;
}

.hero-date-divider {
  width: 2rpx;
  height: 100rpx;
  background: linear-gradient(to bottom, transparent, rgba(201, 184, 173, 0.75), transparent);
  flex-shrink: 0;
}

.hero-date-side {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-week {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 36rpx;
  color: var(--ink);
  letter-spacing: 3rpx;
  font-weight: 700;
}

.hero-lunar {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 24rpx;
  color: var(--ink3);
  letter-spacing: 1rpx;
}

.hero-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.hero-sub-script {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 30rpx;
  color: var(--sage-deep);
  letter-spacing: 3rpx;
  font-weight: 600;
}

.hero-sub-text {
  font-size: 23rpx;
  color: var(--ink3);
  letter-spacing: 1rpx;
}

/* ========== Input Zone — invisible tap area ========== */
.input-zone {
  min-height: 88rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.input-summary {
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.7;
  letter-spacing: 1rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ========== Soft Input Panel ========== */
.soft-input {
  margin-bottom: 24rpx;
  padding: 30rpx 34rpx;
  background: var(--card);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-lg);
  box-shadow: 0 12rpx 36rpx rgba(150, 110, 90, 0.08);
  animation: softReveal 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes softReveal {
  from { opacity: 0; transform: translateY(-12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.soft-textarea {
  width: 100%;
  min-height: 120rpx;
  border: none;
  background: transparent;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.8;
  letter-spacing: 1rpx;
  box-sizing: border-box;
}

/* ========== Recommend Button — coral pill (fit content, centered) ========== */
.btn-rec-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.btn-rec {
  display: inline-block;
  width: auto;
  padding: 28rpx 60rpx;
  border: none;
  border-radius: var(--r-pill);
  background: var(--coral);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  line-height: 1.4;
  box-shadow: 0 14rpx 32rpx rgba(222, 130, 96, 0.34);
}

.btn-rec[disabled] {
  opacity: 0.5;
}

.btn-rec::after {
  border: none;
}

/* ========== No Result ========== */
.no-result {
  text-align: center;
  padding: 80rpx 44rpx;
}

.no-result-icon {
  font-size: 56rpx;
  margin-bottom: 24rpx;
}

.no-result-text {
  font-size: 28rpx;
  color: var(--ink2);
  letter-spacing: 2rpx;
}

.no-result-hint {
  font-size: 24rpx;
  margin-top: 12rpx;
  color: var(--ink4);
}

/* ========== AI Loading Dots ========== */
.ai-loading-dots {
  display: inline-block;
  animation: dots 1.2s steps(4, end) infinite;
  width: 30rpx;
  text-align: left;
  overflow: hidden;
  vertical-align: bottom;
}

@keyframes dots {
  0% { width: 0; }
  25% { width: 10rpx; }
  50% { width: 20rpx; }
  75% { width: 30rpx; }
  100% { width: 30rpx; }
}

.ai-cancel {
  display: inline-block;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--ink3);
  letter-spacing: 2rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-pill);
  background: var(--cream);
}

.ai-cancel:active {
  color: var(--coral-deep);
  border-color: var(--coral);
  transform: scale(0.96);
}

/* ============================================================
   AI Recommendation — Extended Fields
   ============================================================ */

.rec-hero-tagline {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 28rpx;
  color: var(--coral-deep);
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}

/* Narrative recommendation (AI, preferred over bullet reasons) */
.rec-narrative {
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  background: var(--cream2);
  border-left: 6rpx solid var(--coral);
  border-radius: var(--r-md);
  font-family: "Songti SC","STSongti-SC","STSong","SimSun","Noto Serif SC","Source Han Serif SC",serif;
  font-size: 28rpx;
  color: var(--ink2);
  line-height: 1.9;
  letter-spacing: 1rpx;
}

/* Structured reasons (AI) */
.rec-reasons {
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
  background: var(--blush-soft);
  border-radius: var(--r-md);
}

.rec-reason-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.rec-reason-item:last-child {
  margin-bottom: 0;
}

.rec-reason-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--coral);
  flex-shrink: 0;
  margin-top: 16rpx;
}

.rec-reason-text {
  font-size: 27rpx;
  color: var(--ink2);
  line-height: 1.8;
}

/* Taste note */
.rec-taste {
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
  background: var(--sage-soft);
  border-radius: var(--r-md);
}

.rec-taste-label {
  display: block;
  font-size: 22rpx;
  color: var(--sage-deep);
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.rec-taste-text {
  font-size: 27rpx;
  color: var(--ink2);
  line-height: 1.8;
}

/* Brew tip */
.rec-brew-tip {
  font-size: 24rpx;
  color: var(--ink3);
  margin-top: 16rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}

/* Extra hints */
.rec-extra-hints {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(201, 184, 173, 0.3);
}

.rec-hint-line {
  font-size: 24rpx;
  color: var(--ink3);
  margin-bottom: 10rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.rec-hint-line:last-child {
  margin-bottom: 0;
}

/* Alt: why different */
.rec-alt-why {
  font-size: 24rpx;
  color: var(--coral-deep);
  margin: 12rpx 0 8rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}

/* Alt: structured reasons */
.rec-alt-reasons {
  margin-top: 8rpx;
}

.rec-alt-reason-line {
  display: block;
  font-size: 24rpx;
  color: var(--ink3);
  line-height: 1.8;
  padding-left: 20rpx;
  position: relative;
  margin-bottom: 6rpx;
}

.rec-alt-reason-line::before {
  content: '·';
  position: absolute;
  left: 4rpx;
  color: var(--ink4);
}

/* Alt: brew tip */
.rec-alt-brew-tip {
  font-size: 22rpx;
  color: var(--ink4);
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ============================================================
   Checkin & Tasting Notes
   ============================================================ */
.checkin-done-text {
  font-size: 26rpx;
  color: var(--ink3);
  line-height: 1.8;
}

.tasting-entry {
  margin-top: 24rpx;
}

.tasting-trigger {
  display: inline-block;
  font-size: 24rpx;
  color: var(--coral-deep);
  letter-spacing: 2rpx;
  padding: 8rpx 0;
}

.tasting-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: var(--cream);
  line-height: 1.8;
  box-sizing: border-box;
}

.tasting-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.tasting-count {
  font-size: 22rpx;
  color: var(--ink4);
}

.tasting-save-btn {
  padding: 12rpx 34rpx;
  border: none;
  border-radius: var(--r-pill);
  background: var(--coral);
  color: #FFFFFF;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.tasting-save-btn::after {
  border: none;
}

.tasting-saved {
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  background: var(--blush-soft);
  border-radius: var(--r-md);
}

.tasting-saved-text {
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.8;
  display: block;
}

.tasting-edit-link {
  font-size: 22rpx;
  color: var(--coral-deep);
  margin-top: 12rpx;
  display: inline-block;
  letter-spacing: 2rpx;
}

.tasting-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tasting-img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.tasting-img-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-sm);
  background: var(--cream2);
}

.tasting-img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(62, 47, 43, 0.65);
  color: #FFF;
  border-radius: 50%;
  font-size: 24rpx;
}

.tasting-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border: 1rpx dashed rgba(222, 130, 96, 0.4);
  border-radius: var(--r-sm);
  background: var(--cream);
}

.tasting-img-add-icon {
  font-size: 48rpx;
  color: var(--ink4);
  line-height: 1;
}

.tasting-img-add-text {
  font-size: 20rpx;
  color: var(--ink4);
  margin-top: 8rpx;
}

.tasting-img-caption {
  width: 200rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink);
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-sm);
  padding: 4rpx 8rpx;
  text-align: center;
  background: transparent;
}

.tasting-img-saved-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tasting-img-caption-text {
  width: 200rpx;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink4);
  text-align: center;
  line-height: 1.4;
  word-break: break-all;
}

/* ============================================================
   页脚版本号
   ============================================================ */
.page-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 56rpx 0 16rpx;
}

.footer-rule {
  width: 72rpx;
  height: 1rpx;
}

.footer-rule.left {
  background: linear-gradient(to right, transparent, rgba(201, 184, 173, 0.6));
}

.footer-rule.right {
  background: linear-gradient(to left, transparent, rgba(201, 184, 173, 0.6));
}

.footer-ver {
  font-size: 20rpx;
  color: var(--ink4);
  letter-spacing: 4rpx;
}
