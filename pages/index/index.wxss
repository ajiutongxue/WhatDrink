/* ============================================================
   Index Page — 今日推荐
   ============================================================ */

/* Header subtitle (season/solar term) */
.header-sub {
  text-align: center;
  padding: 8rpx 0 20rpx;
}

.season-info {
  font-size: 24rpx;
  color: #B5A89A;
  letter-spacing: 2rpx;
}

/* Textarea placeholder style */
.textarea-placeholder {
  color: #B5A89A;
  font-size: 28rpx;
}

/* No result state */
.no-result {
  text-align: center;
  padding: 80rpx 44rpx;
}

.no-result-icon {
  font-size: 72rpx;
  margin-bottom: 28rpx;
}

.no-result-text {
  font-size: 30rpx;
  color: #3A2A1E;
}

.no-result-hint {
  font-size: 26rpx;
  margin-top: 12rpx;
  color: #B5A89A;
}

/* Checkin done state */
.checkin-done-text {
  font-size: 28rpx;
  color: #6B4F3A;
  text-align: center;
  padding: 12rpx 0;
}

/* AI loading dots animation */
.ai-loading-dots {
  display: inline-block;
  animation: dots 1.2s steps(4, end) infinite;
  width: 30rpx;
  text-align: left;
  overflow: hidden;
  vertical-align: bottom;
}

@keyframes dots {
  0% { width: 0; }
  25% { width: 10rpx; }
  50% { width: 20rpx; }
  75% { width: 30rpx; }
  100% { width: 30rpx; }
}

/* ============================================================
   Tasting Notes (after checkin)
   ============================================================ */
.checkin-done-text {
  font-size: 26rpx;
  color: #8A7668;
  line-height: 1.6;
}

.tasting-entry {
  margin-top: 24rpx;
}

.tasting-trigger {
  display: inline-block;
  font-size: 26rpx;
  color: #C4793B;
  font-weight: 500;
  padding: 8rpx 0;
}

.tasting-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 3rpx solid #F0EBE3;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #3A2A1E;
  background: #FAF5ED;
  line-height: 1.6;
  box-sizing: border-box;
}

.tasting-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.tasting-count {
  font-size: 22rpx;
  color: #B5A89A;
}

.tasting-save-btn {
  padding: 12rpx 32rpx;
  border: none;
  border-radius: 40rpx;
  background: #C4793B;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.tasting-save-btn::after {
  border: none;
}

.tasting-saved {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFF6EE, #FDF8F2);
  border-radius: 20rpx;
  border-left: 6rpx solid #D4956A;
  position: relative;
}

.tasting-saved-text {
  font-size: 26rpx;
  color: #3A2A1E;
  line-height: 1.7;
  display: block;
}

.tasting-edit-link {
  font-size: 22rpx;
  color: #C4793B;
  font-weight: 500;
  margin-top: 12rpx;
  display: inline-block;
}
