  color: var(--ink4);
  letter-spacing: 4rpx;
}

/* ============================================================
   Time-of-Day Foreground Adaptation
   黄昏/夜晚背景偏暗时，前景文字与卡片自动适配
   ============================================================ */

/* Smooth color transitions for all adapted elements */
.phase-dusk .hero-day,
.phase-dusk .hero-week,
.phase-dusk .hero-lunar,
.phase-dusk .solar-name,
.phase-dusk .solar-meaning,
.phase-dusk .solar-custom,
.phase-dusk .hw-temp,
.phase-dusk .hw-desc,
.phase-dusk .hw-sub,
.phase-dusk .hero-sub-script,
.phase-dusk .hero-sub-text,
.phase-dusk .input-summary,
.phase-dusk .footer-ver,
.phase-night .hero-day,
.phase-night .hero-week,
.phase-night .hero-lunar,
.phase-night .solar-name,
.phase-night .solar-meaning,
.phase-night .solar-custom,
.phase-night .hw-temp,
.phase-night .hw-desc,
.phase-night .hw-sub,
.phase-night .hero-sub-script,
.phase-night .hero-sub-text,
.phase-night .input-summary,
.phase-night .footer-ver {
  transition: color 1.5s ease;
}

