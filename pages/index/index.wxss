}

.phase-dusk .hw-temp {
  color: #F2C4A0;
}

.phase-dusk .hw-desc {
  color: rgba(240, 220, 200, 0.8);
}

.phase-dusk .hw-sub {
  color: rgba(240, 220, 200, 0.6);
}

.phase-dusk .hero-sub-script {
  color: #D4B896;
}

.phase-dusk .hero-sub-text {
