  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
  background: var(--sage-soft);
  border-radius: var(--r-md);
}

.rec-taste-label {
  display: block;
  font-size: 22rpx;
  color: var(--sage-deep);
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
