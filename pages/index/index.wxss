/* ============================================================
   Index Page — 今日推荐
   ============================================================ */

/* Header subtitle (season/solar term) */
.header-sub {
  text-align: center;
  padding: 8rpx 0 20rpx;
}

.season-info {
  font-size: 24rpx;
  color: #B5A89A;
  letter-spacing: 2rpx;
}

/* Textarea placeholder style */
.textarea-placeholder {
  color: #B5A89A;
  font-size: 28rpx;
}

/* No result state */
.no-result {
  text-align: center;
  padding: 80rpx 44rpx;
}

.no-result-icon {
  font-size: 72rpx;
  margin-bottom: 28rpx;
}

.no-result-text {
  font-size: 30rpx;
  color: #3A2A1E;
}

.no-result-hint {
  font-size: 26rpx;
  margin-top: 12rpx;
  color: #B5A89A;
}

/* Checkin done state */
.checkin-done-text {
  font-size: 28rpx;
  color: #6B4F3A;
  text-align: center;
  padding: 12rpx 0;
}

/* AI loading dots animation */
.ai-loading-dots {
  display: inline-block;
  animation: dots 1.2s steps(4, end) infinite;
  width: 30rpx;
  text-align: left;
  overflow: hidden;
  vertical-align: bottom;
}

@keyframes dots {
  0% { width: 0; }
  25% { width: 10rpx; }
  50% { width: 20rpx; }
  75% { width: 30rpx; }
  100% { width: 30rpx; }
}
