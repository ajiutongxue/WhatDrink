/* ============================================================
   Index Page — 今日推荐 「暖屿」
   柔和粉彩 + 印章点缀 + 手写体标题，像一张温暖的茶笺
   ============================================================ */

/* ========== Dynamic Scene Background — 3-Layer Architecture ========== */
.scene-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  overflow: hidden;
  opacity: 0;
  transition: opacity 0.8s ease;
}

/* Fade in once scene data is ready */
.scene-ready {
  opacity: 1;
}

.scene-base,
.scene-overlay,
.scene-tint {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* Smooth transitions when switching scenes */
.scene-base {
  transition: opacity 1.2s ease, filter 1.8s ease;
}

.scene-overlay {
  transition: opacity 1.2s ease;
}

/* L3: Time-of-day color tint overlay */
.scene-tint {
  pointer-events: none;
  transition: background 2s ease;
}

.tint-dawn  { background: rgba(160, 180, 240, 0.06); }
.tint-day   { background: transparent; }
.tint-dusk  { background: rgba(255, 120, 40, 0.10); }
.tint-night { background: rgba(15, 20, 60, 0.28); }

/* Time-of-day filters on base layer */
.phase-dawn .scene-base {
  filter: brightness(0.96) saturate(0.88);
}

.phase-dusk .scene-base {
  filter: brightness(0.9) saturate(0.82) hue-rotate(-5deg);
}

.phase-night .scene-base {
  filter: brightness(0.82) saturate(0.65) hue-rotate(8deg);
}

/* ===== Weather Overlay Animations ===== */

/* Rain: steady diagonal fall */
@keyframes rain-fall {
  from { transform: translateY(-40rpx) translateX(6rpx); }
  to   { transform: translateY(40rpx) translateX(-6rpx); }
}
.anim-rain {
  animation: rain-fall 1s linear infinite;
}

/* Snow: slow drift with gentle sway */
@keyframes snow-fall {
  0%   { transform: translateY(-24rpx) translateX(0) rotate(0deg); }
  33%  { transform: translateY(0) translateX(8rpx) rotate(2deg); }
  66%  { transform: translateY(24rpx) translateX(-4rpx) rotate(-1deg); }
  100% { transform: translateY(48rpx) translateX(0) rotate(0deg); }
}
.anim-snow {
  animation: snow-fall 5s ease-in-out infinite;
}

/* Clouds: slow wide horizontal drift */
@keyframes cloud-drift {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(30rpx); }
}
.anim-clouds {
  animation: cloud-drift 10s ease-in-out infinite;
}

/* Stars: gentle opacity pulse (twinkle) */
@keyframes twinkle {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.5; }
}
.anim-twinkle {
  animation: twinkle 3.5s ease-in-out infinite;
}

/* Lightning: rare intermittent flash */
@keyframes lightning {
  0%, 93%, 100% { opacity: 0; }
  94%, 95.5%    { opacity: 1; }
  95%           { opacity: 0.2; }
}
.anim-lightning {
  animation: lightning 8s linear infinite;
}

/* Fog: very slow lateral drift */
@keyframes fog-drift {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(-40rpx); }
}
.anim-fog {
  animation: fog-drift 14s ease-in-out infinite;
}

/* Sun: gentle breathing glow */
@keyframes sun-breathe {
  0%, 100% { transform: scale(1); opacity: 0.88; }
  50%      { transform: scale(1.04); opacity: 1; }
}
.anim-sun {
  animation: sun-breathe 6s ease-in-out infinite;
}

/* Overcast: subtle brightness variation */
@keyframes overcast-pulse {
  0%, 100% { opacity: 0.88; }
  50%      { opacity: 1; }
}
.anim-overcast {
  animation: overcast-pulse 8s ease-in-out infinite;
}

/* ========== Hero Header ========== */
.hero {
  padding-bottom: 40rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

/* Solar term — name + meaning, text only (no background block) */
.solar {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.solar-name {
  font-family: "Songti SC","STSongti-SC","STSong","SimSun","Noto Serif SC","Source Han Serif SC",serif;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--coral-deep);
  letter-spacing: 4rpx;
}

.solar-meaning {
  font-family: "Songti SC","STSongti-SC","STSong","SimSun","Noto Serif SC","Source Han Serif SC",serif;
  font-size: 21rpx;
  color: var(--ink3);
  letter-spacing: 2rpx;
  line-height: 1.5;
}

.solar-custom {
  font-family: "Songti SC","STSongti-SC","STSong","SimSun","Noto Serif SC","Source Han Serif SC",serif;
  font-size: 21rpx;
  color: var(--ink2);
  letter-spacing: 2rpx;
  line-height: 1.5;
}

.hero-weather {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", "Segoe UI", sans-serif;
}

.hw-main {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.hw-temp {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--coral);
  letter-spacing: 1rpx;
}

.hw-desc {
  font-size: 24rpx;
  color: var(--ink2);
  letter-spacing: 1rpx;
}

.hw-sub {
  font-size: 20rpx;
  color: var(--ink3);
  letter-spacing: 1rpx;
}

/* Big date — serif, bold, orderly */
.hero-date {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-bottom: 28rpx;
}

.hero-day {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 160rpx;
  font-weight: 700;
  color: var(--cocoa);
  line-height: 1;
  letter-spacing: 0;
}

.hero-date-divider {
  width: 2rpx;
  height: 100rpx;
  background: linear-gradient(to bottom, transparent, rgba(201, 184, 173, 0.75), transparent);
  flex-shrink: 0;
}

.hero-date-side {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-week {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 36rpx;
  color: var(--ink);
  letter-spacing: 3rpx;
  font-weight: 700;
}

.hero-lunar {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 24rpx;
  color: var(--ink3);
  letter-spacing: 1rpx;
}

.hero-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.hero-sub-script {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 30rpx;
  color: var(--sage-deep);
  letter-spacing: 3rpx;
  font-weight: 600;
}

.hero-sub-text {
  font-size: 23rpx;
  color: var(--ink3);
  letter-spacing: 1rpx;
}

/* ========== Input Zone — invisible tap area ========== */
.input-zone {
  min-height: 88rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.input-summary {
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.7;
  letter-spacing: 1rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ========== Soft Input Panel ========== */
.soft-input {
  margin-bottom: 24rpx;
  padding: 30rpx 34rpx;
  background: var(--card);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-lg);
  box-shadow: 0 12rpx 36rpx rgba(150, 110, 90, 0.08);
  animation: softReveal 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes softReveal {
  from { opacity: 0; transform: translateY(-12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.soft-textarea {
  width: 100%;
  min-height: 120rpx;
  border: none;
  background: transparent;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.8;
  letter-spacing: 1rpx;
  box-sizing: border-box;
}

/* ========== Recommend Button — coral pill (fit content, centered) ========== */
.btn-rec-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.btn-rec {
  display: inline-block;
  width: auto;
  padding: 28rpx 60rpx;
  border: none;
  border-radius: var(--r-pill);
  background: var(--coral);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  line-height: 1.4;
  box-shadow: 0 14rpx 32rpx rgba(222, 130, 96, 0.34);
}

.btn-rec[disabled] {
  opacity: 0.5;
}

.btn-rec::after {
  border: none;
}

/* ========== No Result ========== */
.no-result {
  text-align: center;
  padding: 80rpx 44rpx;
}

.no-result-icon {
  font-size: 56rpx;
  margin-bottom: 24rpx;
}

.no-result-text {
  font-size: 28rpx;
  color: var(--ink2);
  letter-spacing: 2rpx;
}

.no-result-hint {
  font-size: 24rpx;
  margin-top: 12rpx;
  color: var(--ink4);
}

/* ========== AI Loading Dots ========== */
.ai-loading-dots {
  display: inline-block;
  animation: dots 1.2s steps(4, end) infinite;
  width: 30rpx;
  text-align: left;
  overflow: hidden;
  vertical-align: bottom;
}

@keyframes dots {
  0% { width: 0; }
  25% { width: 10rpx; }
  50% { width: 20rpx; }
  75% { width: 30rpx; }
  100% { width: 30rpx; }
}

.ai-cancel {
  display: inline-block;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--ink3);
  letter-spacing: 2rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-pill);
  background: var(--cream);
}

.ai-cancel:active {
  color: var(--coral-deep);
  border-color: var(--coral);
  transform: scale(0.96);
}

/* ============================================================
   AI Recommendation — Extended Fields
   ============================================================ */

.rec-hero-tagline {
  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 28rpx;
  color: var(--coral-deep);
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}

/* Narrative recommendation (AI, preferred over bullet reasons) */
.rec-narrative {
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  background: var(--cream2);
  border-left: 6rpx solid var(--coral);
  border-radius: var(--r-md);
  font-family: "Songti SC","STSongti-SC","STSong","SimSun","Noto Serif SC","Source Han Serif SC",serif;
  font-size: 28rpx;
  color: var(--ink2);
  line-height: 1.9;
  letter-spacing: 1rpx;
}

/* Structured reasons (AI) */
