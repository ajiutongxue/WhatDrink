/* ============================================================
   Index Page — 今日推荐
   ============================================================ */

/* Header subtitle (season/solar term) */
.header-sub {
  text-align: center;
  padding: 8rpx 0 20rpx;
}

.season-info {
  font-size: 24rpx;
  color: #B5A89A;
  letter-spacing: 2rpx;
}

/* Textarea placeholder style */
.textarea-placeholder {
  color: #B5A89A;
  font-size: 28rpx;
}

/* No result state */
.no-result {
  text-align: center;
  padding: 80rpx 44rpx;
}

.no-result-icon {
  font-size: 72rpx;
  margin-bottom: 28rpx;
}

.no-result-text {
  font-size: 30rpx;
  color: #3A2A1E;
}

.no-result-hint {
  font-size: 26rpx;
  margin-top: 12rpx;
  color: #B5A89A;
}

/* Checkin done state */
.checkin-done-text {
  font-size: 28rpx;
  color: #6B4F3A;
  text-align: center;
  padding: 12rpx 0;
}

/* AI loading dots animation */
.ai-loading-dots {
  display: inline-block;
  animation: dots 1.2s steps(4, end) infinite;
  width: 30rpx;
  text-align: left;
  overflow: hidden;
  vertical-align: bottom;
}

@keyframes dots {
  0% { width: 0; }
  25% { width: 10rpx; }
  50% { width: 20rpx; }
  75% { width: 30rpx; }
  100% { width: 30rpx; }
}

/* ============================================================
   Tasting Notes (after checkin)
   ============================================================ */
.checkin-done-text {
  font-size: 26rpx;
  color: #8A7668;
  line-height: 1.6;
}

.tasting-entry {
  margin-top: 24rpx;
}

.tasting-trigger {
  display: inline-block;
  font-size: 26rpx;
  color: #C4793B;
  font-weight: 500;
  padding: 8rpx 0;
}

.tasting-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 3rpx solid #F0EBE3;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #3A2A1E;
  background: #FAF5ED;
  line-height: 1.6;
  box-sizing: border-box;
}

.tasting-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.tasting-count {
  font-size: 22rpx;
  color: #B5A89A;
}

.tasting-save-btn {
  padding: 12rpx 32rpx;
  border: none;
  border-radius: 40rpx;
  background: #C4793B;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.tasting-save-btn::after {
  border: none;
}

.tasting-saved {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFF6EE, #FDF8F2);
  border-radius: 20rpx;
  border-left: 6rpx solid #D4956A;
  position: relative;
}

.tasting-saved-text {
  font-size: 26rpx;
  color: #3A2A1E;
  line-height: 1.7;
  display: block;
}

.tasting-edit-link {
  font-size: 22rpx;
  color: #C4793B;
  font-weight: 500;
  margin-top: 12rpx;
  display: inline-block;
}

.tasting-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tasting-img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.tasting-img-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F0E8DA;
}

.tasting-img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
}

.tasting-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  margin-top: 16rpx;
  border: 2rpx dashed #D3C3B0;
  border-radius: 12rpx;
  background: #FAF5ED;
}

.tasting-img-add-icon {
  font-size: 56rpx;
  color: #B5A89A;
  line-height: 1;
}

.tasting-img-add-text {
  font-size: 20rpx;
  color: #B5A89A;
  margin-top: 8rpx;
}

.tasting-img-caption {
  width: 200rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #3A2A1E;
  border: 1rpx solid #E5DDD0;
  border-radius: 6rpx;
  padding: 4rpx 8rpx;
  text-align: center;
}

.tasting-img-saved-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tasting-img-caption-text {
  width: 200rpx;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #888780;
  text-align: center;
  line-height: 1.3;
  word-break: break-all;
}

.tasting-reaction {
  margin-top: 16rpx;
}

.tasting-reaction-label {
  font-size: 24rpx;
  color: #888780;
  display: block;
  margin-bottom: 8rpx;
}

.tasting-reaction-row {
  display: flex;
  gap: 16rpx;
}

.tasting-reaction-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border: 1rpx solid #E5DDD0;
  border-radius: 24rpx;
  color: #888780;
  background: #FAF5ED;
}

.tasting-reaction-btn.active.good { background: #E1F5EE; color: #0F6E56; border-color: #5DCAA5; }
.tasting-reaction-btn.active.neutral { background: #F1EFE8; color: #5F5E5A; border-color: #B4B2A9; }
.tasting-reaction-btn.active.bad { background: #FAECE7; color: #993C1D; border-color: #F5C4B3; }

.tasting-reaction-effects {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tasting-effect-btn {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border: 1rpx solid #E5DDD0;
  border-radius: 20rpx;
  color: #888780;
  background: #FFFDF9;
}

.tasting-effect-btn.active {
  background: #C4793B;
  color: #fff;
  border-color: #C4793B;
}

.tasting-reaction-display {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.tasting-reaction-tag {
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: 16rpx;
}

.tasting-reaction-tag.good { background: #E1F5EE; color: #0F6E56; }
.tasting-reaction-tag.neutral { background: #F1EFE8; color: #5F5E5A; }
.tasting-reaction-tag.bad { background: #FAECE7; color: #993C1D; }
.tasting-reaction-tag.effect { background: #FAF0E6; color: #C4793B; }
