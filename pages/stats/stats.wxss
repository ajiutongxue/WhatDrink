/* ============================================================
   Stats Page — 饮茶统计
   ============================================================ */

.stats-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
  padding: 0 4rpx;
}

.stats-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.stats-month {
  font-size: 24rpx;
  color: var(--ink4);
}

.stats-card {
  margin-bottom: 28rpx;
}

/* ---- Donut ---- */
.stats-donut-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.stats-donut {
  width: 300rpx;
  height: 300rpx;
}

/* ---- Legend ---- */
.stats-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 28rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(176, 164, 148, 0.2);
}

.stats-legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
}

.stats-legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.stats-legend-name {
  color: var(--ink2);
}

.stats-legend-val {
  color: var(--ink4);
}

/* ---- Bars (nature + top) ---- */
.stats-bars {
  margin-top: 8rpx;
}

.stats-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.stats-bar-label {
  width: 48rpx;
  font-size: 26rpx;
  color: var(--ink2);
  flex-shrink: 0;
}

.stats-bar-track {
  flex: 1;
  height: 16rpx;
  background: rgba(176, 164, 148, 0.15);
  border-radius: 8rpx;
  overflow: hidden;
}

.stats-bar-fill {
  height: 100%;
  border-radius: 8rpx;
}

.stats-bar-fill.accent {
  background: var(--gold);
}

.stats-bar-val {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--ink3);
  flex-shrink: 0;
}

/* ---- Top 5 ---- */
.stats-top {
  margin-top: 8rpx;
}

.stats-top-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stats-top-rank {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(176, 164, 148, 0.15);
  color: var(--ink3);
  font-size: 24rpx;
  flex-shrink: 0;
}

.stats-top-rank.rank-1 { background: var(--gold); color: #FDFBF7; }
.stats-top-rank.rank-2 { background: rgba(184, 149, 107, 0.6); color: #FDFBF7; }
.stats-top-rank.rank-3 { background: rgba(176, 164, 148, 0.5); color: #FDFBF7; }

.stats-top-info {
  flex: 1;
  min-width: 0;
}

.stats-top-name {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 400;
  margin-bottom: 8rpx;
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  letter-spacing: 1rpx;
}

/* ---- Frequency ---- */
.stats-freq {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 130rpx;
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.stats-freq-col {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 100%;
}

.stats-freq-bar {
  width: 100%;
  border-radius: 4rpx 4rpx 0 0;
  min-height: 8rpx;
}

.stats-freq-axis {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--ink4);
  margin-top: 12rpx;
  padding: 0 4rpx;
}

.stats-freq-summary {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--ink2);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(176, 164, 148, 0.2);
}

.stats-freq-summary .dot {
  color: var(--ink4);
}

/* ---- Empty ---- */
.stats-empty {
  text-align: center;
  color: var(--ink4);
  padding: 48rpx 0;
  font-size: 26rpx;
}
