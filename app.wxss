/* ============================================================
   今天喝点什么茶 — Design System v3
   文人画卷：留白即意境，背景即设计
   ============================================================ */

page {
  --ink: #2C2418;
  --ink2: #5A4D3E;
  --ink3: #8A7D6C;
  --ink4: #B0A494;
  --gold: #B8956B;
  --gold-dim: rgba(184, 149, 107, 0.15);
  --glass: rgba(255, 253, 248, 0.55);
  --glass-border: rgba(255, 255, 255, 0.4);
  --sage: #7A8B6F;
  --rose: #A67B7B;
  --r-sm: 12rpx;
  --r-md: 24rpx;
  --r-lg: 36rpx;

  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  background: #F5F0E8;
  color: var(--ink);
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
  letter-spacing: 1rpx;
}

/* ============================================================
   Page Container — content floats on SVG background
   ============================================================ */
.page-container {
  position: relative;
  z-index: 1;
  padding: 0 48rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
}

/* ============================================================
   Glass Panel — the ONLY container metaphor
   ============================================================ */
.glass {
  background: var(--glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-lg);
}

/* ============================================================
   Card — subtle section container for sub-pages
   ============================================================ */
.card {
  background: rgba(255, 253, 248, 0.45);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: var(--r-lg);
  padding: 36rpx 40rpx;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 22rpx;
  color: var(--ink4);
  margin-bottom: 24rpx;
  letter-spacing: 3rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title .icon {
  font-size: 28rpx;
  opacity: 0.6;
}

/* ============================================================
   Typography
   ============================================================ */
.t-display {
  font-size: 140rpx;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -2rpx;
}

.t-title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.t-body {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.8;
}

.t-caption {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink3);
  letter-spacing: 1rpx;
}

.t-small {
  font-size: 22rpx;
  color: var(--ink4);
}

/* ============================================================
   Parsed Tags — minimal, text-only with subtle bg
   ============================================================ */
.parsed-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.tag-state { background: rgba(184, 149, 107, 0.12); color: var(--ink2); }
.tag-city { background: rgba(122, 139, 111, 0.12); color: #4A5E40; }
.tag-mood { background: rgba(90, 120, 150, 0.10); color: #3A5A70; }
.tag-avoid { background: rgba(166, 123, 123, 0.12); color: #7A4A4A; }
.tag-prefer { background: rgba(122, 139, 111, 0.12); color: #4A5E40; }

/* ============================================================
   Recommendation — Primary (glass panel)
   ============================================================ */
.rec-hero {
  background: var(--glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-lg);
  padding: 48rpx 44rpx;
  margin-bottom: 32rpx;
  position: relative;
}

.rec-hero-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  color: var(--ink3);
  margin-bottom: 28rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid var(--ink4);
}

.rec-hero-badge.ai {
  color: var(--gold);
  border-bottom-color: var(--gold);
}

.rec-hero-badge.primary {
  color: var(--ink3);
  border-bottom-color: var(--ink4);
}

.rec-hero-name {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
  margin-bottom: 4rpx;
  letter-spacing: 3rpx;
}

.rec-hero-brand {
  font-size: 26rpx;
  color: var(--ink3);
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
}

.rec-hero-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}

.rec-hero-tag {
  font-size: 22rpx;
  padding: 4rpx 0;
  font-weight: 400;
  letter-spacing: 1rpx;
  color: var(--ink3);
  border-bottom: 1rpx solid rgba(176, 164, 148, 0.4);
}

.nature-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  color: #FFFFFF;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.nature-han { background: #6A8FA8; }
.nature-liang { background: #7AAAB8; }
.nature-ping { background: #9A9A90; }
.nature-wen { background: #B8885A; }
.nature-re { background: #A86A5A; }

.cat-tag {
  color: var(--ink2);
  border-bottom-color: rgba(90, 77, 62, 0.3);
}

.info-tag {
  color: var(--ink4);
  border-bottom-color: rgba(176, 164, 148, 0.3);
}

.rec-hero-reason {
  font-size: 28rpx;
  color: var(--ink2);
  line-height: 2;
  margin-bottom: 28rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--gold);
}

.rec-hero-reason text {
  color: var(--ink2);
  font-weight: 400;
}

.rec-hero-brew {
  display: flex;
  gap: 36rpx;
  font-size: 24rpx;
  color: var(--ink3);
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(176, 164, 148, 0.25);
  letter-spacing: 1rpx;
}

.avoid-info {
  font-size: 24rpx;
  color: var(--ink3);
  margin-top: 24rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--rose);
  line-height: 1.7;
}

/* ============================================================
   Alt Card — lighter glass
   ============================================================ */
.rec-alt {
  background: rgba(255, 253, 248, 0.4);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: var(--r-lg);
  padding: 36rpx 40rpx;
  margin-bottom: 32rpx;
  display: flex;
  gap: 28rpx;
  align-items: flex-start;
}

.rec-alt-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(184, 149, 107, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.rec-alt-body { flex: 1; min-width: 0; }

.rec-alt-badge {
  display: inline-block;
  font-size: 20rpx;
  color: var(--ink4);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.rec-alt-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.rec-alt-brand {
  font-size: 24rpx;
  color: var(--ink4);
  margin-left: 12rpx;
}

.rec-alt-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: 12rpx 0;
}

.rec-alt-reason {
  font-size: 24rpx;
  color: var(--ink3);
  line-height: 1.8;
  margin-top: 12rpx;
}

.rec-alt-brew {
  font-size: 22rpx;
  color: var(--ink4);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

/* ============================================================
   AI-Specific
   ============================================================ */
.ai-notice {
  font-size: 20rpx;
  color: var(--gold);
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.rec-reason-ai {
  font-size: 28rpx;
  color: var(--ink2);
  line-height: 2;
  margin-bottom: 28rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--gold);
}

.rec-reason-ai text {
  color: var(--ink2);
  font-weight: 400;
}

.ai-loading {
  text-align: center;
  padding: 80rpx 40rpx;
}

.ai-loading-icon { font-size: 56rpx; margin-bottom: 28rpx; opacity: 0.6; }
.ai-loading-text { font-size: 28rpx; color: var(--ink2); letter-spacing: 3rpx; }
.ai-loading-sub { font-size: 22rpx; color: var(--ink4); margin-top: 12rpx; }
.ai-loading-dots { display: inline-block; width: 30rpx; text-align: left; }

/* ============================================================
   Checkin — minimal, no card
   ============================================================ */
.checkin-card {
  padding: 40rpx 0;
  margin-bottom: 32rpx;
}

.checkin-title {
  font-size: 24rpx;
  color: var(--ink4);
  margin-bottom: 24rpx;
  letter-spacing: 3rpx;
}

.checkin-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.checkin-pill {
  flex: 1;
  min-width: 0;
  padding: 20rpx 12rpx;
  border: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: var(--r-md);
  background: rgba(255, 253, 248, 0.5);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  font-size: 26rpx;
  color: var(--ink2);
  text-align: center;
  font-weight: 400;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.checkin-pill::after { border: none; }
.checkin-pill.hero { border-color: var(--gold); color: var(--ink); }
.checkin-pill.secondary { border-style: dashed; }
.checkin-pill.muted { color: var(--ink4); border-color: rgba(176, 164, 148, 0.25); }

.checkin-custom {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-top: 20rpx;
}

.checkin-custom input {
  flex: 1;
  border: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: var(--r-md);
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  background: rgba(255, 253, 248, 0.5);
  color: var(--ink);
  outline: none;
}

.checkin-custom-btn {
  padding: 18rpx 32rpx;
  border: none;
  border-radius: var(--r-md);
  background: var(--ink);
  color: #FDFBF7;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.checkin-custom-btn::after { border: none; }

/* ============================================================
   History
   ============================================================ */
.history-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(176, 164, 148, 0.2);
}

.history-item:last-child { border-bottom: none; }
.history-date { font-size: 24rpx; color: var(--ink4); min-width: 92rpx; }
.history-dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0; }
.history-tea { flex: 1; }
.history-tea-name { font-size: 28rpx; font-weight: 500; color: var(--ink); letter-spacing: 1rpx; }
.history-tea-cat { font-size: 22rpx; color: var(--ink4); margin-top: 4rpx; }

.history-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 8rpx;
  letter-spacing: 1rpx;
}

.badge-primary { background: var(--gold-dim); color: var(--gold); }
.badge-alt { background: rgba(176, 164, 148, 0.1); color: var(--ink3); }
.badge-custom { background: rgba(122, 139, 111, 0.1); color: var(--sage); }

.history-empty { text-align: center; color: var(--ink4); padding: 100rpx 40rpx; font-size: 28rpx; line-height: 2; }
.history-empty-icon { font-size: 48rpx; margin-bottom: 24rpx; opacity: 0.5; }

/* Category dots */
.cat-dot-green { background: #7A8B6F; }
.cat-dot-black { background: #8A7060; }
.cat-dot-white { background: #A8B0A8; }
.cat-dot-oolong_tieguanyin, .cat-dot-oolong_wuyi, .cat-dot-oolong_dancong { background: #B8956B; }
.cat-dot-puerh_raw { background: #7A8B6F; }
.cat-dot-puerh_ripe { background: #5A4A3A; }
.cat-dot-flavored_jasmine, .cat-dot-flavored_other { background: #A67B7B; }
.cat-dot-unknown { background: var(--gold); }
.cat-dot-none, .cat-dot-skip { background: var(--ink4); }

/* ============================================================
   Settings
   ============================================================ */
.setting-group { margin-bottom: 40rpx; }

.setting-label {
  font-size: 22rpx;
  color: var(--ink4);
  margin-bottom: 12rpx;
  display: block;
  letter-spacing: 2rpx;
}

.setting-input {
  width: 100%;
  border: none;
  border-bottom: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: 0;
  padding: 16rpx 4rpx;
  font-size: 28rpx;
  background: transparent;
  color: var(--ink);
  outline: none;
}

.setting-row { display: flex; gap: 32rpx; }
.setting-row .setting-group { flex: 1; }

.radio-group { display: flex; gap: 24rpx; margin-top: 8rpx; }
.radio-group label { display: flex; align-items: center; gap: 10rpx; font-size: 28rpx; }

.setting-btn {
  padding: 16rpx 32rpx;
  border: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: var(--r-md);
  background: transparent;
  font-size: 26rpx;
  color: var(--ink2);
}

.setting-btn::after { border: none; }
.setting-btn.danger { color: var(--rose); border-color: rgba(166, 123, 123, 0.4); }

.data-btn-row { display: flex; gap: 16rpx; flex-wrap: wrap; }
.sync-status { font-size: 22rpx; color: var(--ink4); margin-bottom: 16rpx; }

.setting-toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.setting-toggle-label { font-size: 28rpx; color: var(--ink2); }

/* ============================================================
   Quiz
   ============================================================ */
.quiz-q { margin: 32rpx 0; }
.quiz-q-text { font-size: 28rpx; font-weight: 500; margin-bottom: 16rpx; letter-spacing: 1rpx; }
.quiz-opts { display: flex; gap: 16rpx; flex-wrap: wrap; }

.quiz-opt {
  padding: 14rpx 28rpx;
  border: 1rpx solid rgba(176, 164, 148, 0.4);
  border-radius: var(--r-md);
  font-size: 26rpx;
  background: transparent;
  color: var(--ink2);
}

.quiz-opt.selected {
  background: var(--ink);
  color: #FDFBF7;
  border-color: var(--ink);
}

.quiz-result {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--gold);
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.8;
}

/* ============================================================
   Tea Library
   ============================================================ */
.tea-lib-filter-bar {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 0 28rpx;
}

.tea-lib-filter-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: var(--r-md);
  font-size: 24rpx;
  margin-right: 16rpx;
  background: transparent;
  color: var(--ink3);
  border: 1rpx solid rgba(176, 164, 148, 0.3);
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.tea-lib-filter-item.active {
  background: var(--ink);
  color: #FDFBF7;
  border-color: var(--ink);
}

.tea-lib-cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 8rpx;
}

.tea-lib-cat-name { font-size: 28rpx; color: var(--ink); font-weight: 600; letter-spacing: 2rpx; }
.tea-lib-cat-count { font-size: 22rpx; color: var(--ink4); }

.tea-lib-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(176, 164, 148, 0.15);
  font-size: 26rpx;
}

.tea-lib-item:last-child { border-bottom: none; }
.tea-lib-cat-dot { width: 10rpx; height: 10rpx; border-radius: 50%; flex-shrink: 0; }
.tea-lib-name { flex: 1; font-weight: 400; letter-spacing: 1rpx; }
.tea-lib-props { font-size: 22rpx; color: var(--ink4); display: flex; gap: 8rpx; }

/* ============================================================
   Section animation
   ============================================================ */
.rec-section {
  animation: recFadeIn 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes recFadeIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============================================================
   Misc
   ============================================================ */
.muted-text { color: var(--ink4); }
.skip-name { color: var(--ink4); }
.nature-mini-tag { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 4rpx; color: #FFF; }
