/* ============================================================
   今天喝点什么茶 — Design System v4 「暖屿」
   融合暖调：奶油底色 + 珊瑚橙 + 鼠尾草绿 + 深棕锚点
   柔和、圆润、有情绪温度，像一杯刚沏好的茶
   ============================================================ */

page {
  /* —— 底色 —— */
  --cream: #FBF3E7;
  --cream2: #F6EADB;
  --blush: #F5DCC9;
  --blush-soft: #FAEADD;

  /* —— 主色：珊瑚橙 —— */
  --coral: #DE8260;
  --coral-deep: #C96B4C;
  --coral-soft: rgba(222, 130, 96, 0.14);

  /* —— 辅色：鼠尾草绿 —— */
  --sage: #8FAE87;
  --sage-deep: #6F9468;
  --sage-soft: #DDE9D6;

  /* —— 点缀：柔紫（雨天）—— */
  --lav: #B4A8C8;

  /* —— 深棕锚点 & 文字阶 —— */
  --cocoa: #3E2F2B;
  --ink: #4A3A33;
  --ink2: #75625A;
  --ink3: #A08D83;
  --ink4: #C9B8AD;

  /* —— 卡片 & 圆角 —— */
  --card: rgba(255, 252, 246, 0.78);
  --card-border: rgba(222, 130, 96, 0.16);
  --r-sm: 16rpx;
  --r-md: 28rpx;
  --r-lg: 40rpx;
  --r-pill: 999rpx;

  font-family: "Songti SC", "STSongti-SC", "STSong", "SimSun", "Noto Serif SC", "Source Han Serif SC", serif;
  background: var(--cream);
  color: var(--ink);
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
  letter-spacing: 1rpx;
}

/* ============================================================
   Page Container
   ============================================================ */
.page-container {
  position: relative;
  z-index: 1;
  padding: 0 40rpx;
  padding-bottom: 64rpx;
  min-height: 100vh;
}

/* ============================================================
   Card — 柔和粉彩容器
   ============================================================ */
.card {
  background: var(--card);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-lg);
  padding: 36rpx 38rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(150, 110, 90, 0.06);
}

.card-title {
  font-size: 24rpx;
  color: var(--ink2);
  margin-bottom: 26rpx;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-weight: 600;
}

.card-title .icon {
  font-size: 30rpx;
}

/* ============================================================
   Typography
   ============================================================ */
.t-display {
  font-size: 132rpx;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -2rpx;
  color: var(--cocoa);
}

.t-title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: var(--cocoa);
}

.t-body {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.8;
}

.t-caption {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink3);
  letter-spacing: 1rpx;
}

.t-small {
  font-size: 22rpx;
  color: var(--ink4);
}

/* ============================================================
   Parsed Tags — 圆润胶囊
   ============================================================ */
.parsed-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.tag-state { background: var(--coral-soft); color: var(--coral-deep); }
.tag-city { background: var(--sage-soft); color: var(--sage-deep); }
.tag-mood { background: rgba(180, 168, 200, 0.16); color: #7A6B96; }
.tag-avoid { background: rgba(200, 120, 110, 0.14); color: #B05A4A; }
.tag-prefer { background: var(--sage-soft); color: var(--sage-deep); }

/* ============================================================
   Recommendation — Primary (柔和卡片)
   ============================================================ */
.rec-hero {
  background: var(--card);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-lg);
  padding: 46rpx 42rpx;
  margin-bottom: 28rpx;
  position: relative;
  box-shadow: 0 16rpx 44rpx rgba(150, 110, 90, 0.08);
}

.rec-hero-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--r-pill);
  margin-bottom: 26rpx;
}

.rec-hero-badge.ai {
  color: #FFFFFF;
  background: var(--coral);
}

.rec-hero-badge.primary {
  color: var(--sage-deep);
  background: var(--sage-soft);
}

.rec-hero-name {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--cocoa);
  line-height: 1.3;
  margin-bottom: 4rpx;
  letter-spacing: 3rpx;
}

.rec-hero-brand {
  font-size: 26rpx;
  color: var(--ink3);
  margin-bottom: 26rpx;
  letter-spacing: 2rpx;
}

.rec-hero-tags {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.rec-hero-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  color: var(--ink2);
  background: var(--cream2);
  border-radius: var(--r-pill);
}

.nature-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  color: #FFFFFF;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.nature-han { background: #7FA6C0; }
.nature-liang { background: #8FC0C8; }
.nature-ping { background: #A8A89C; }
.nature-wen { background: #D99A6A; }
.nature-re { background: #CE7A66; }

.cat-tag {
  color: var(--sage-deep);
  background: var(--sage-soft);
}

.info-tag {
  color: var(--ink3);
  background: var(--cream2);
}

.rec-hero-reason {
  font-size: 28rpx;
  color: var(--ink2);
  line-height: 2;
  margin-bottom: 26rpx;
  padding: 22rpx 26rpx;
  background: var(--blush-soft);
  border-radius: var(--r-md);
}

.rec-hero-reason text {
  color: var(--ink2);
  font-weight: 400;
}

.rec-hero-brew {
  display: flex;
  gap: 32rpx;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: var(--ink2);
  padding: 22rpx 26rpx;
  background: var(--sage-soft);
  border-radius: var(--r-md);
  letter-spacing: 1rpx;
}

.avoid-info {
  font-size: 24rpx;
  color: #B05A4A;
  margin-top: 22rpx;
  padding: 18rpx 24rpx;
  background: rgba(200, 120, 110, 0.1);
  border-radius: var(--r-md);
  line-height: 1.7;
}

/* ============================================================
   Alt Card — 更浅的粉彩
   ============================================================ */
.rec-alt {
  background: rgba(255, 252, 246, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(143, 174, 135, 0.2);
  border-radius: var(--r-lg);
  padding: 34rpx 36rpx;
  margin-bottom: 28rpx;
  display: flex;
  gap: 26rpx;
  align-items: flex-start;
}

.rec-alt-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--sage-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.rec-alt-body { flex: 1; min-width: 0; }

.rec-alt-badge {
  display: inline-block;
  font-size: 20rpx;
  color: var(--sage-deep);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.rec-alt-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--cocoa);
  letter-spacing: 2rpx;
}

.rec-alt-brand {
  font-size: 24rpx;
  color: var(--ink4);
  margin-left: 12rpx;
}

.rec-alt-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: 12rpx 0;
}

.rec-alt-reason {
  font-size: 24rpx;
  color: var(--ink3);
  line-height: 1.8;
  margin-top: 12rpx;
}

.rec-alt-brew {
  font-size: 22rpx;
  color: var(--ink4);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

/* ============================================================
   AI-Specific
   ============================================================ */
.ai-notice {
  font-size: 20rpx;
  color: var(--coral-deep);
  margin-bottom: 22rpx;
  letter-spacing: 2rpx;
}

.rec-reason-ai {
  font-size: 28rpx;
  color: var(--ink2);
  line-height: 2;
  margin-bottom: 26rpx;
  padding: 22rpx 26rpx;
  background: var(--blush-soft);
  border-radius: var(--r-md);
}

.rec-reason-ai text {
  color: var(--ink2);
  font-weight: 400;
}

.ai-loading {
  text-align: center;
  padding: 80rpx 40rpx;
}

.ai-loading-icon { font-size: 56rpx; margin-bottom: 28rpx; }
.ai-loading-text { font-size: 28rpx; color: var(--ink2); letter-spacing: 3rpx; }
.ai-loading-sub { font-size: 22rpx; color: var(--ink4); margin-top: 12rpx; }
.ai-loading-dots { display: inline-block; width: 30rpx; text-align: left; }

/* ============================================================
   Checkin — 圆润胶囊按钮
   ============================================================ */
.checkin-card {
  padding: 36rpx 38rpx;
  margin-bottom: 28rpx;
  background: var(--card);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-lg);
}

.checkin-title {
  font-size: 24rpx;
  color: var(--ink2);
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.checkin-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.checkin-pill {
  flex: 1;
  min-width: 0;
  padding: 22rpx 12rpx;
  border: none;
  border-radius: var(--r-md);
  background: var(--cream2);
  font-size: 26rpx;
  color: var(--ink2);
  text-align: center;
  font-weight: 400;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.checkin-pill::after { border: none; }
.checkin-pill.hero { background: var(--coral); color: #FFFFFF; }
.checkin-pill.secondary { background: var(--sage-soft); color: var(--sage-deep); }
.checkin-pill.muted { color: var(--ink3); background: var(--cream2); }

.checkin-custom {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-top: 20rpx;
}

.checkin-custom input {
  flex: 1;
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-md);
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  background: var(--cream);
  color: var(--ink);
  outline: none;
}

.checkin-custom-btn {
  padding: 18rpx 34rpx;
  border: none;
  border-radius: var(--r-md);
  background: var(--cocoa);
  color: var(--cream);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.checkin-custom-btn::after { border: none; }

/* ============================================================
   History
   ============================================================ */
.history-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.3);
}

.history-item:last-child { border-bottom: none; }
.history-date { font-size: 24rpx; color: var(--ink4); min-width: 92rpx; }
.history-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.history-tea { flex: 1; }
.history-tea-name { font-size: 28rpx; font-weight: 500; color: var(--cocoa); letter-spacing: 1rpx; }
.history-tea-cat { font-size: 22rpx; color: var(--ink4); margin-top: 4rpx; }

.history-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  margin-left: 8rpx;
  letter-spacing: 1rpx;
}

.badge-primary { background: var(--coral-soft); color: var(--coral-deep); }
.badge-alt { background: var(--cream2); color: var(--ink3); }
.badge-custom { background: var(--sage-soft); color: var(--sage-deep); }

.history-empty { text-align: center; color: var(--ink4); padding: 100rpx 40rpx; font-size: 28rpx; line-height: 2; }
.history-empty-icon { font-size: 52rpx; margin-bottom: 24rpx; }

/* Category dots */
.cat-dot-green { background: #8FAE87; }
.cat-dot-black { background: #9C7B6A; }
.cat-dot-white { background: #BCC4BC; }
.cat-dot-oolong_tieguanyin, .cat-dot-oolong_wuyi, .cat-dot-oolong_dancong { background: #DE8260; }
.cat-dot-puerh_raw { background: #8FAE87; }
.cat-dot-puerh_ripe { background: #6B5344; }
.cat-dot-flavored_jasmine, .cat-dot-flavored_other { background: #C98A9A; }
.cat-dot-unknown { background: var(--coral); }
.cat-dot-none, .cat-dot-skip { background: var(--ink4); }

/* ============================================================
   Settings
   ============================================================ */
.setting-group { margin-bottom: 40rpx; }

.setting-label {
  font-size: 22rpx;
  color: var(--ink3);
  margin-bottom: 12rpx;
  display: block;
  letter-spacing: 2rpx;
}

.setting-input {
  width: 100%;
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-md);
  padding: 18rpx 26rpx;
  font-size: 28rpx;
  background: var(--cream);
  color: var(--ink);
  outline: none;
}

.setting-row { display: flex; gap: 32rpx; }
.setting-row .setting-group { flex: 1; }

.radio-group { display: flex; gap: 24rpx; margin-top: 8rpx; }
.radio-group label { display: flex; align-items: center; gap: 10rpx; font-size: 28rpx; }

.setting-btn {
  padding: 18rpx 34rpx;
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-pill);
  background: var(--cream);
  font-size: 26rpx;
  color: var(--ink2);
}

.setting-btn::after { border: none; }
.setting-btn.danger { color: #B05A4A; border-color: rgba(200, 120, 110, 0.4); background: rgba(200,120,110,0.06); }

.data-btn-row { display: flex; gap: 16rpx; flex-wrap: wrap; }
.sync-status { font-size: 22rpx; color: var(--ink4); margin-bottom: 16rpx; }

.setting-toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.setting-toggle-label { font-size: 28rpx; color: var(--ink2); }

/* ============================================================
   Quiz
   ============================================================ */
.quiz-q { margin: 32rpx 0; }
.quiz-q-text { font-size: 28rpx; font-weight: 500; margin-bottom: 16rpx; letter-spacing: 1rpx; color: var(--cocoa); }
.quiz-opts { display: flex; gap: 16rpx; flex-wrap: wrap; }

.quiz-opt {
  padding: 16rpx 30rpx;
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-pill);
  font-size: 26rpx;
  background: var(--cream);
  color: var(--ink2);
}

.quiz-opt.selected {
  background: var(--coral);
  color: #FFFFFF;
  border-color: var(--coral);
}

.quiz-result {
  margin-top: 28rpx;
  padding: 26rpx 30rpx;
  background: var(--blush-soft);
  border-radius: var(--r-md);
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.8;
}

/* ============================================================
   Tea Library
   ============================================================ */
.tea-lib-filter-bar {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 0 28rpx;
}

.tea-lib-filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  margin-right: 16rpx;
  background: var(--cream);
  color: var(--ink3);
  border: 1rpx solid var(--card-border);
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.tea-lib-filter-item.active {
  background: var(--coral);
  color: #FFFFFF;
  border-color: var(--coral);
}

.tea-lib-cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 8rpx;
}

.tea-lib-cat-name { font-size: 28rpx; color: var(--cocoa); font-weight: 600; letter-spacing: 2rpx; }
.tea-lib-cat-count { font-size: 22rpx; color: var(--ink4); }

.tea-lib-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(201, 184, 173, 0.25);
  font-size: 26rpx;
}

.tea-lib-item:last-child { border-bottom: none; }
.tea-lib-cat-dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0; }
.tea-lib-name { flex: 1; font-weight: 400; letter-spacing: 1rpx; color: var(--ink); }
.tea-lib-props { font-size: 22rpx; color: var(--ink4); display: flex; gap: 8rpx; }

/* ============================================================
   Section animation
   ============================================================ */
.rec-section {
  animation: recFadeIn 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes recFadeIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============================================================
   Misc
   ============================================================ */
.muted-text { color: var(--ink4); }
.skip-name { color: var(--ink4); }
.nature-mini-tag { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: var(--r-pill); color: #FFF; }
